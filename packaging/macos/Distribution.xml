<?xml version="1.0" encoding="utf-8"?>
<!--
  The installer's own description, read by productbuild.

  `hostArchitectures` names both because the payload is universal: without it,
  an Intel machine is told the package is not for it even though the binary
  inside runs there natively.

  There is no `<choices-outline>` with more than one choice, and that is
  deliberate. This installs four programs, one shared library and one header,
  all of which are the same thing; a choice screen that let somebody install the
  shell without the CLI would produce configurations nobody tests.
-->
<installer-gui-script minSpecVersion="2">
    <title>inillucent</title>
    <organization>com.blackrainbowlabs</organization>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64" />

    <welcome file="welcome.txt" mime-type="text/plain" />
    <license file="LICENSE" mime-type="text/plain" />
    <conclusion file="conclusion.txt" mime-type="text/plain" />

    <!-- Nothing older than 10.15 has a Rust toolchain target we build for. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="10.15" />
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="default">
            <line choice="com.blackrainbowlabs.inillucent" />
        </line>
    </choices-outline>

    <choice id="default" />
    <choice id="com.blackrainbowlabs.inillucent" visible="false">
        <pkg-ref id="com.blackrainbowlabs.inillucent" />
    </choice>

    <!--
      The `#` is not decoration and the whitespace is not harmless. A pkg-ref's text is a URL, and
      `#name.pkg` means "the entry called name.pkg inside this archive"; without the `#` it is a
      relative path to something outside, which is not there. Apple's notary service answered
      `The contents of the package could not be extracted` and `has no signed executables or
      bundles. No tickets can be generated` for an archive that was otherwise byte-for-byte the
      shape of a real one. `node-v26.9.0.pkg` writes `>#node-v26.9.0.pkg<`, on one line, and so does
      this. productbuild normalised it on the way past, which is why it was never wrong on a Mac.
    -->
    <pkg-ref id="com.blackrainbowlabs.inillucent" version="@VERSION@" onConclusion="none">#inillucent-component-@VERSION@.pkg</pkg-ref>
</installer-gui-script>
