# Recorded by tools/record-mcp-transcript.py.
# The server: inillucent-mcp.exe, on a scratch database.
# The handshake Claude Code sends and the first four calls an agent makes: list the tools, look at the tables, describe one, read it.
#
# C lines are what the client sent; S lines are what the server answered.
# `mcp_replay.rs` sends the C lines and compares the S lines, with the
# request id and every timing field masked.
C {"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"claude-code","version":"1.0.0"}}}
C {"jsonrpc":"2.0","method":"notifications/initialized"}
C {"jsonrpc":"2.0","id":1,"method":"tools/list","params":{}}
C {"jsonrpc":"2.0","id":2,"method":"tools/call","params":{"name":"inillucent_tables","arguments":{}}}
C {"jsonrpc":"2.0","id":3,"method":"tools/call","params":{"name":"inillucent_describe","arguments":{"table":"t"}}}
C {"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"inillucent_query","arguments":{"sql":"SELECT id, body FROM t ORDER BY id"}}}
S {"jsonrpc":"2.0","id":0,"result":{"protocolVersion":"2025-06-18","capabilities":{"tools":{"listChanged":false}},"serverInfo":{"name":"inillucent","version":"0.1.7"},"instructions":"inillucent is an embedded SQL database that speaks SQLite's dialect, with full-text and vector search built in. Call inillucent_tables to see what is there, inillucent_describe before writing SQL against a table you did not create, inillucent_query to read and inillucent_exec to write. If a call comes back with status 'unsupported', that construct is not built yet - it is not a mistake in your SQL, and rewording it will not help."}}
S {"jsonrpc":"2.0","id":1,"result":{"tools":[{"name":"inillucent_query","description":"Run a SELECT and get its rows back.\n\nUse this for anything that reads. The rows come back as a table, or as typed JSON with output=json. 'total' is exact even when 'limit' cut the rows handed back, because the engine materialises the whole result - so a limit of 10 on a million-row query still costs what the million rows cost. Put a LIMIT in the SQL itself when you cannot afford that, where the planner can act on it.","inputSchema":{"type":"object","properties":{"sql":{"type":"string","description":"The SQL to run. One statement. Use ?1, ?2 ... for values you pass in 'params' rather than pasting them into the text."},"params":{"type":"array","description":"The values for ?1, ?2 ... in order, as a JSON array of strings, numbers, booleans or nulls. An array of numbers is a vector and {\"blob\":\"<hex>\"} is bytes. Binding is how you avoid quoting mistakes and SQL injection.","items":{"type":["string","number","boolean","null"]}},"params-file":{"type":"string","description":"A file holding the JSON array for 'params', or - for standard input. What a wrapper that spawns this binary uses: a command line has a length ceiling, about 32 KB on Windows, and a parameter past it fails outright."},"limit":{"type":"integer","description":"How many rows to hand back. The count in 'total' is still exact, and 'more' says whether anything was cut off. Defaults to 200. Over MCP there is a ceiling of 10000 rows and 0 (every row) is refused; on the command line there is neither. A negative number is refused on both."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":["sql"],"additionalProperties":false}},{"name":"inillucent_exec","description":"Run one statement that changes something, and get the row count back.\n\nINSERT, UPDATE, DELETE, CREATE, DROP, ALTER, or a PRAGMA that sets a value. A statement with RETURNING gives its rows back as well as its count.","inputSchema":{"type":"object","properties":{"sql":{"type":"string","description":"One statement to run for its effect: INSERT, UPDATE, DELETE, CREATE, DROP, ALTER or a PRAGMA that sets something."},"params":{"type":"array","description":"The values for ?1, ?2 ... in order, as a JSON array. An array of numbers is a vector and {\"blob\":\"<hex>\"} is bytes.","items":{"type":["string","number","boolean","null"]}},"params-file":{"type":"string","description":"A file holding the JSON array for 'params', or - for standard input. What a wrapper that spawns this binary uses: a command line has a length ceiling, about 32 KB on Windows, and a parameter past it fails outright."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":["sql"],"additionalProperties":false}},{"name":"inillucent_batch","description":"Run several statements as one transaction.\n\nSeparate them with semicolons. Either all of them take effect or none of them do, which is what you want when creating a schema or loading related rows.","inputSchema":{"type":"object","properties":{"sql":{"type":"string","description":"Several statements separated by semicolons. They run as one transaction: either all of them take effect or none of them do."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":["sql"],"additionalProperties":false}},{"name":"inillucent_run","description":"Run shell input, dot commands and all, and get back what it printed.\n\nThe escape hatch, and the reason every dot command is reachable from every front end: this drives the same shell 'inillucent shell' does. Use it for the things that have no verb of their own - '.eqp on', '.parameter set', '.testcase', '.archive'. Run 'inillucent run \".help\"' for the full list of dot commands.","inputSchema":{"type":"object","properties":{"input":{"type":"string","description":"Shell input, exactly as you would type it: SQL statements ending in a semicolon, and dot commands such as '.schema' or '.mode box' on their own lines. Everything the interactive shell can do is reachable here."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."}},"required":["input"],"additionalProperties":false}},{"name":"inillucent_create","description":"Make a new, empty database file.\n\nRefuses a path that already exists, so it can never destroy a database by being run twice. Every other command opens whatever it is pointed at.","inputSchema":{"type":"object","properties":{"path":{"type":"string","description":"Where to make the new database file. It refuses a path that already exists rather than overwriting it."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":["path"],"additionalProperties":false}},{"name":"inillucent_tables","description":"List the tables and views.\n\nThe names, with what each one is. System tables whose names begin with sqlite_ are left out.","inputSchema":{"type":"object","properties":{"pattern":{"type":"string","description":"A LIKE pattern to filter the names by, such as 'user%'. Omit it for all of them."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_describe","description":"Everything about one table: columns, types, keys, indexes, row count and DDL.\n\nCall this before writing SQL against a table you did not create. It answers in one call what four separate pragmas would, which matters because a caller that has to make four usually makes three and writes its query from an incomplete picture.","inputSchema":{"type":"object","properties":{"table":{"type":"string","description":"The table or view to describe, by its exact name. Use 'tables' first if you are not sure what it is called."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":["table"],"additionalProperties":false}},{"name":"inillucent_schema","description":"Show the CREATE statements for the whole database or for what a pattern names.\n\nThe schema as SQL, which is the form you can paste into another database.","inputSchema":{"type":"object","properties":{"pattern":{"type":"string","description":"A LIKE pattern naming which objects to show. Omit it for the whole schema."},"indent":{"type":"boolean","description":"Pretty-print each CREATE statement over several lines instead of one."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_indexes","description":"List the indexes and the table each one is on.\n\nIncluding the ones a UNIQUE constraint or a primary key created, which is why an index you did not write may appear here.","inputSchema":{"type":"object","properties":{"pattern":{"type":"string","description":"A LIKE pattern to filter the names by, such as 'user%'. Omit it for all of them."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_databases","description":"List the attached databases and the file behind each.\n\n'main' is the one that was opened; others come from ATTACH. 'temp' is the session's own scratch database and has no file.","inputSchema":{"type":"object","properties":{"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_explain","description":"Show the query plan for a statement without running it.\n\nWhich indexes are used, which scans are full, and in what order the tables are joined. This is how you find out why a query is slow before making it faster.","inputSchema":{"type":"object","properties":{"sql":{"type":"string","description":"The statement whose plan you want. It is not run - this only shows which indexes and scans the planner chose."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":["sql"],"additionalProperties":false}},{"name":"inillucent_import","description":"Load a CSV or tab-separated file into a table.\n\nThe table is created from the file's first row if it does not exist. Quoting is RFC 4180 unless a different format is asked for.","inputSchema":{"type":"object","properties":{"file":{"type":"string","description":"The delimited file to read."},"table":{"type":"string","description":"The table to load into. If it does not exist it is created, taking its column names from the file's first row."},"format":{"type":"string","description":"'csv' (the default, RFC 4180 quoting), 'tabs', or 'ascii' for \\037 and \\036 separated input.","enum":["csv","tabs","ascii"]},"skip":{"type":"integer","description":"How many leading rows to ignore, for a file with a preamble above its header."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."}},"required":["file","table"],"additionalProperties":false}},{"name":"inillucent_export","description":"Write a table or a query's rows out as CSV, JSON or one of six other formats.\n\nWith 'out' the rows go to a file and the result says so; without it they come back in the result, which is usually what an agent wants.","inputSchema":{"type":"object","properties":{"table":{"type":"string","description":"The table to write out whole. Give this or 'sql', not both."},"sql":{"type":"string","description":"A query whose rows to write out, when you want less than a whole table."},"format":{"type":"string","description":"csv, json, tabs, markdown, insert, quote, line or html. Defaults to csv.","enum":["csv","json","tabs","markdown","insert","quote","line","html"]},"out":{"type":"string","description":"A file to write to. Omitted, the rows come back in the result instead."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."}},"required":[],"additionalProperties":false}},{"name":"inillucent_dump","description":"Render the database as the SQL that would rebuild it.\n\nSchema and data, in dependency order, inside a transaction. This is the portable form: it is text, and another SQLite-speaking database will read it.","inputSchema":{"type":"object","properties":{"objects":{"type":"string","description":"A LIKE pattern for the tables, indexes, triggers or views to dump. Omit it for the whole database."},"data_only":{"type":"boolean","description":"Write only the INSERT statements, leaving out the CREATE statements."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."}},"required":[],"additionalProperties":false}},{"name":"inillucent_backup","description":"Write a copy of the database to another file.\n\nA consistent copy taken while the database is open. The copy is a database, not a text dump.","inputSchema":{"type":"object","properties":{"file":{"type":"string","description":"Where to write the copy."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."}},"required":["file"],"additionalProperties":false}},{"name":"inillucent_restore","description":"Point this session at a backup file, in place of the database it opened.\n\nThe opposite of 'backup', and it does not overwrite anything: this engine's databases are whole files, so restoring is opening the other file rather than writing its pages over the one you are in. That means it lasts as long as the session does - useful from the shell and from 'run', where the statements after it read the restored file, and of no effect on its own, because a one-shot process ends immediately after. To replace a file, copy the backup over it. A backup file that is not there is refused rather than created empty.","inputSchema":{"type":"object","properties":{"file":{"type":"string","description":"The copy to read back. It replaces what is in the open database."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."}},"required":["file"],"additionalProperties":false}},{"name":"inillucent_checkpoint","description":"Fold the write-ahead log back into the database file.\n\nWrites go to a log first and are folded in later. Doing it now shrinks the log and is what you want before copying the file by hand.","inputSchema":{"type":"object","properties":{"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_integrity_check","description":"Read every page and report whether the database holds together.\n\nAnswers 'ok' on a healthy database. Anything else names what is wrong. It reads the whole file, so it costs what the file costs.","inputSchema":{"type":"object","properties":{"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_analyze","description":"Gather the statistics the query planner reads.\n\nRun it after loading a lot of data. Without statistics the planner guesses at how selective an index is, and a wrong guess is the usual reason a query that should use an index does not.","inputSchema":{"type":"object","properties":{"table":{"type":"string","description":"One table to gather statistics for. Omit it for every table."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_stats","description":"Report the page cache, the pool size and the shape of the file.\n\nCache hits and misses, how many pages the file holds and how many are free. This is where you look when a workload is slower than it should be.","inputSchema":{"type":"object","properties":{"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_search","description":"Full-text search over an FTS5 or inillucent_search table.\n\nWrites the MATCH ... ORDER BY rank idiom for you, which is the part nobody remembers. The table has to be a full-text one; 'describe' will show you whether it is.","inputSchema":{"type":"object","properties":{"query":{"type":"string","description":"What to search for, in FTS5 query syntax: bare words are ANDed, \"a phrase\" is quoted, and OR and NOT are available."},"table":{"type":"string","description":"The full-text table to search - one created with USING fts5(...) or USING inillucent_search(...)."},"k":{"type":"integer","description":"How many results to return, best first. Defaults to 10."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":["query","table"],"additionalProperties":false}},{"name":"inillucent_vector_search","description":"Find the rows whose vector is nearest to one you supply.\n\nOver a VECTOR(N) column, by cosine distance unless you ask for another measure. If there is an HNSW index on the column the planner uses it; if there is not, this is an exhaustive scan and is still correct.","inputSchema":{"type":"object","properties":{"table":{"type":"string","description":"The table holding the vectors."},"column":{"type":"string","description":"The VECTOR(N) column to measure against."},"vector":{"type":"array","description":"The query vector, as a JSON array of numbers with exactly N elements.","items":{"type":["string","number","boolean","null"]}},"k":{"type":"integer","description":"How many nearest rows to return. Defaults to 10."},"measure":{"type":"string","description":"'cos' for cosine distance (the default), 'l2' for Euclidean, or 'dot' for the inner product."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":["table","column","vector"],"additionalProperties":false}},{"name":"inillucent_capabilities","description":"Ask what this engine can do before composing a statement.\n\nEvery row is checked against the running engine by a test, in both directions - a claim of support that fails and a claim of absence that now works each turn the build red. So this is worth trusting in a way a hand-maintained feature list is not. A name that is not in the table answers no, because a capability that was never declared was never checked.","inputSchema":{"type":"object","properties":{"name":{"type":"string","description":"One capability to ask about, such as 'triggers'. Omit it for the whole table. A name that is not in the table answers no, not yes."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_functions","description":"List the SQL functions this engine answers.\n\nFrom the engine's own register, which is compared against the reference library's on every build - so this is what actually exists rather than what was documented once.","inputSchema":{"type":"object","properties":{"pattern":{"type":"string","description":"A LIKE pattern to filter the names by, such as 'user%'. Omit it for all of them."},"db":{"type":"string","description":"The database file to run against. Defaults to the one this process was started on, or :memory: for a scratch database that is discarded when the process ends."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_migrate","description":"Build an inillucent database from a SQLite file, PostgreSQL or MySQL.\n\nReads the source and writes a new .rdb with the same rows. A path is a SQLite database file; a postgres:// or mysql:// URL is a running server, read inside one repeatable-read snapshot so that every table is as of one instant. The source is never written to and the destination is never overwritten: the new file is staged under another name and published by a rename, so a half-written database never sits where an application would open it. A server migration is verified per table by row count and by an order-independent digest, and nothing that fails a check is published.","inputSchema":{"type":"object","properties":{"source":{"type":"string","description":"The SQLite database file to read, or a postgres:// or mysql:// connection URL. The source is never written to. A connection URL holds a password, and an argument is visible in the process list for the whole run - so it may be left out and given in INILLUCENT_SOURCE_URL instead, or written as '-' to read one line from standard input."},"destination":{"type":"string","description":"The .rdb file to build. It refuses to overwrite an existing file."},"kind":{"type":"string","description":"'sqlite' (the default for a path), 'postgres' or 'mysql' (the default for a URL written with that scheme), or 'index' for a legacy retrieval index."},"batch":{"type":"integer","description":"Rows per destination transaction while copying from a server. Default 10000. It changes how long the migration takes and nothing about what it produces."},"insecure-plaintext":{"type":"boolean","description":"Permit an unencrypted connection to a server. A migration to a host that is not a loopback address uses verified TLS, and refuses rather than falling back; this permits plaintext, and only together with sslmode=disable in the URL. Both are needed because either one alone is something people type without meaning it. The choice is recorded in the migration report."}},"required":["destination"],"additionalProperties":false}},{"name":"inillucent_setup_embeddings","description":"Download and install the embedding model and the runtime it needs.\n\nOne command, on Windows, macOS and Linux. It fetches ONNX Runtime and the nomic-embed-text-v1.5 weights into a per-user directory, checks every byte against a digest pinned in this build, and leaves the engine able to answer embed(TEXT) with nothing exported by hand - so a mismatch is a refusal that names both digests rather than a shared library that loads and misbehaves. Name what you want: 'all' installs both halves, 'runtime' and 'model' one each. Run with no component at all and it reports what is installed and downloads nothing, which is what stops a 620 MB fetch being a surprise; '--status' does the same explicitly. About 620 MB the first time and nothing on a later run. '--residency' chooses when the model is in memory: 'resident' keeps it, which is about 1.9 GB held and 12 to 36 ms a query; 'on-demand' loads it per call, which holds nothing and costs about 0.8 s a query; 'idle' or 'idle:90s' loads it on use and drops it after a quiet period, which is the default and pays the load once for a burst of questions.","inputSchema":{"type":"object","properties":{"component":{"type":"string","description":"Which half to install: 'all' (the default), 'runtime' for the ONNX Runtime shared library on its own, or 'model' for the weights on their own."},"status":{"type":"boolean","description":"Say what is installed, where, and which residency profile is in force, and download nothing."},"residency":{"type":"string","description":"When the model is in memory: 'resident' keeps it for the life of the process, 'on-demand' loads it per call and drops it, 'idle' or 'idle:90s' loads it on use and drops it after a quiet period. Recorded for this machine; INILLUCENT_EMBED_RESIDENCY overrides it for one process."},"gpu":{"type":"boolean","description":"Install the ONNX Runtime build carrying the CUDA execution provider, which exists for Windows and Linux on x86-64 only. It is a much larger download and it needs a CUDA install of its own to be usable."},"force":{"type":"boolean","description":"Fetch and install again even when the files are already there and their digests match."},"onnxruntime-version":{"type":"string","description":"The ONNX Runtime version to install. Defaults to the one this build pins a digest for; any other version is fetched and reported as unverified."},"dir":{"type":"string","description":"Install somewhere other than the per-user directory. INILLUCENT_HOME does the same thing for every command at once."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_version","description":"Report the engine, the dialect and the driver versions.\n\nThe SQLite version named here is the dialect this engine implements, not a library it links. There is no SQLite in this binary.","inputSchema":{"type":"object","properties":{"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}},{"name":"inillucent_help","description":"List every command, or explain one in full.\n\nWith no topic it prints the table. With one it prints that command's usage, what it is for, and every parameter it takes.","inputSchema":{"type":"object","properties":{"topic":{"type":"string","description":"A command to explain in full. Omit it for the list of every command."},"output":{"type":"string","description":"'text' for an aligned table a person reads, or 'json' for the whole result object, with typed values, exact counts and the failure class. Defaults to text.","enum":["text","json"]}},"required":[],"additionalProperties":false}}]}}
S {"jsonrpc":"2.0","id":2,"result":{"content":[{"type":"text","text":"name  type\n----  -----\nt     table"}],"isError":false}}
S {"jsonrpc":"2.0","id":3,"result":{"content":[{"type":"text","text":"t: 2 columns, 2 rows\n\ncid  name  type     notnull  dflt_value  pk\n---  ----  -------  -------  ----------  --\n0    id    INTEGER  0                    1\n1    body  TEXT     0                    0\n\nindexes: none\n\nCREATE TABLE t (id INTEGER PRIMARY KEY, body TEXT)"}],"isError":false}}
S {"jsonrpc":"2.0","id":4,"result":{"content":[{"type":"text","text":"id  body\n--  ----\n1   one\n2   two"}],"isError":false}}
