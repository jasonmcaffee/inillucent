query T rowsort
SELECT a, g FROM t

case retained-bug-42-vacuum-generated
statement ok
CREATE TABLE t(a, g TEXT AS (a || 'x') STORED)

statement ok
INSERT INTO t(a) VALUES (1)

statement ok
VACUUM

case retained-bug-43-returning-virtual-table
statement ok
CREATE VIRTUAL TABLE f USING fts5(a)

statement ok
INSERT INTO f(rowid, a) VALUES (1, 'x')

statement error
DELETE FROM f RETURNING rowid

case retained-bug-43-upsert-virtual-table
statement ok
