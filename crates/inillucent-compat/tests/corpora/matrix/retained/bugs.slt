statement error
INSERT INTO f(rowid, a) VALUES (1, 'x') ON CONFLICT DO NOTHING

case retained-bug-44-insert-ignore-fts
statement ok
CREATE VIRTUAL TABLE f USING fts5(a, b)

statement ok
INSERT INTO f(rowid, a, b) VALUES (2, 'p', 'q')

statement ok
CREATE TABLE r(k, a, w)

statement ok
INSERT INTO r VALUES (2, 20, 'z'), (3, 30, 'w')

statement ok
INSERT OR IGNORE INTO f(rowid, a, b) SELECT k, a, w FROM r

query T rowsort
SELECT rowid, a, b FROM f

case retained-bug-45-or-rollback-virtual-table
statement ok
CREATE VIRTUAL TABLE f USING fts5(a, b)

statement ok
INSERT INTO f(rowid, a, b) VALUES (2, 'ABC', 'q')

statement ok
BEGIN

query T rowsort
INSERT OR ROLLBACK INTO f(rowid, a, b) VALUES (2, 'new', 'n')

query I rowsort
SELECT 1

case retained-bug-46-shadow-tables
statement ok
CREATE VIRTUAL TABLE f USING fts5(a)

query T rowsort
SELECT name, type FROM pragma_table_list WHERE name LIKE 'f%'

query T rowsort
SELECT name, sql FROM sqlite_schema WHERE name = 'f_config'

