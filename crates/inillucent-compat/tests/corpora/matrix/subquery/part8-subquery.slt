# Moved from crates/inillucent-compat/tests/corpora/differential-part8/subquery.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

setup

statement ok
CREATE TABLE a(id INTEGER, v INTEGER)

statement ok
CREATE TABLE b(id INTEGER, w INTEGER)

statement ok
INSERT INTO a VALUES(1,10),(2,20),(3,NULL)

statement ok
INSERT INTO b VALUES(1,100),(1,200),(2,NULL)

case sub-001

query II rowsort
SELECT id,(SELECT sum(w) FROM b WHERE b.id=a.id) FROM a ORDER BY id

case sub-002

query I nosort
SELECT id FROM a WHERE EXISTS(SELECT 1 FROM b WHERE b.id=a.id) ORDER BY id

case sub-003

query I nosort
SELECT id FROM a WHERE NOT EXISTS(SELECT 1 FROM b WHERE b.id=a.id) ORDER BY id

case sub-004

query TT rowsort
SELECT (SELECT w FROM b ORDER BY w) AS x, typeof((SELECT w FROM b))

case sub-005

query T nosort
SELECT id FROM a WHERE v IN (SELECT w FROM b) ORDER BY id

case sub-006

query T nosort
SELECT id FROM a WHERE v NOT IN (SELECT w FROM b) ORDER BY id

case sub-007

query T nosort
SELECT id FROM a WHERE v > (SELECT min(w) FROM b) ORDER BY id

case sub-008

query II rowsort
SELECT id, (SELECT count(*) FROM b WHERE b.w > a.v) FROM a ORDER BY id

case sub-009

query II rowsort
SELECT * FROM (SELECT id, max(v) mv FROM a GROUP BY id) WHERE mv > 10 ORDER BY id

case sub-010
capability row_value_in_subquery

query T rowsort
SELECT id FROM a WHERE (id,v) IN (SELECT id,w FROM b)

case sub-011

query II rowsort
SELECT EXISTS(SELECT 1 WHERE 0), EXISTS(SELECT NULL)

case sub-012

query T rowsort
SELECT id FROM a WHERE v = (SELECT w FROM b WHERE b.id = 99)

case sub-013

query IT rowsort
SELECT a.id, (SELECT group_concat(w) FROM b WHERE b.id=a.id) FROM a ORDER BY a.id

case sub-014

statement error
SELECT id FROM a WHERE v > ALL (SELECT w FROM b WHERE b.id=1)

case sub-015

query I rowsort
SELECT count(*) FROM a WHERE id IN (SELECT id FROM b GROUP BY id HAVING count(*)>1)

