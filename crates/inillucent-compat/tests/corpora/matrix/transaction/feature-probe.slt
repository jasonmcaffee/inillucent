statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

case probe-txn.drop.rollback

statement ok
BEGIN

statement ok
DROP TABLE t

statement ok
ROLLBACK

query I rowsort
SELECT count(*) FROM t

setup

statement ok
CREATE TABLE t(a INTEGER PRIMARY KEY)

statement ok
INSERT INTO t VALUES (3)

case probe-txn.statement.atomic

statement error
INSERT INTO t SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3

setup

case probe-txn.commit.none

statement error
COMMIT

case probe-txn.begin.nested

statement ok
BEGIN

statement error
BEGIN

setup

