# Moved from crates/inillucent-compat/tests/corpora/differential-part8/string.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

case str-001

query IITIII rowsort
SELECT length('abc'), length(''), length(NULL), length(x'010203'), length(123), length(1.5)

case str-002

query IIII rowsort
SELECT length('café'), length('é'), length('😀'), length('中文')

case str-003

query TTTTT rowsort
SELECT substr('abcdef',2), substr('abcdef',2,3), substr('abcdef',-2), substr('abcdef',-2,1), substr('abcdef',0,2)

case str-004

query TTTT rowsort
SELECT substr('abcdef',2,-1), substr('abcdef',4,-2), substr('abc',10), substr('abc',1,100)

case str-005

query TTT rowsort
SELECT substr('中文abc',1,2), substr('😀x',1,1), substr('😀x',2,1)

case str-006

query TTTT rowsort
SELECT upper('abcé'), lower('ABCÉ'), upper('ß'), lower('İ')

case str-007

query IIIIT rowsort
SELECT instr('abcabc','bc'), instr('abc','z'), instr('abc',''), instr('','a'), instr(NULL,'a')

case str-008

query II rowsort
SELECT instr(x'010203', x'02'), instr('中文abc','abc')

case str-009

query TTTT rowsort
SELECT replace('aaa','a','bb'), replace('abc','','x'), replace('abc','b',''), replace(NULL,'a','b')

case str-010

query TTTTT rowsort
SELECT trim('  ab  '), ltrim('  ab  '), rtrim('  ab  '), trim('xxabxx','x'), trim('abc','cba')

case str-011

query TTTT rowsort
SELECT trim('abc',''), ltrim('aaa','a'), rtrim('',''), trim(1.0)

case str-012

query TTTTTT rowsort
SELECT hex('abc'), hex(x'00ff'), hex(1), hex(1.5), hex(NULL), hex('é')

case str-013

query IIITT rowsort
SELECT unicode('a'), unicode('é'), unicode('😀'), unicode(''), unicode(NULL)

case str-014

query TTTTI rowsort
SELECT char(97,98), char(233), char(128512), char(), char(0)=''

case str-015

query TTTTTT rowsort
SELECT quote('a''b'), quote(1), quote(1.5), quote(NULL), quote(x'00ff'), quote('')

case str-016

query TTTTT rowsort
SELECT 'a' || 'b', 'a' || 1, 1 || 2, NULL || 'a', x'41' || 'b'

case str-017

query TTT rowsort
SELECT rtrim('ab  ') || '|', printf('[%10s]','ab'), printf('[%-10s]','ab')

case str-018

query TT rowsort
SELECT replace('中文','中','X'), upper('中文')

case str-019

query TI rowsort
SELECT ltrim(' ab'), length(trim('  ab 
'))

case str-020

query TTT rowsort
SELECT substr(x'0102030405',2,2), hex(substr(x'0102030405',2,2)), typeof(substr(x'0102',1,1))

case str-021

query TT rowsort
SELECT format('%s-%s','a','b'), format('%d',3)

case str-022

query TTTTT rowsort
SELECT printf('%c', 65), printf('%i', 42), printf('%o', 8), printf('%X', 255), printf('%u', 5)

case str-023

query TTT rowsort
SELECT printf('%.3s','abcdef'), printf('%+d',5), printf('% d',5)

case str-024

query TTTT rowsort
SELECT printf('%q','a''b'), printf('%Q','a''b'), printf('%Q',NULL), printf('%w','a"b')

case str-025

query TT rowsort
SELECT printf('%z',1), printf('%*d', 5, 42)

case str-026

query TT rowsort
SELECT concat('a','b',NULL,'c'), concat_ws('-','a',NULL,'b')

case str-027

query TI rowsort
SELECT char(0x41) || char(0x42), unicode(char(0x10FFFF))

case str-028

query TTT rowsort
SELECT lower(x'4142'), upper(x'4142'), typeof(lower(x'4142'))

case str-029

statement error
SELECT soundex('Robert'), soundex('Rupert')

case str-030

query TTTT rowsort
SELECT unhex('414243'), unhex('4z'), typeof(unhex('41')), hex(unhex('00'))

case str-031

query III rowsort
SELECT octet_length('abc'), octet_length('é'), octet_length(x'0102')

case str-032

query TT rowsort
SELECT rtrim('abcxx','x'), rtrim('abc','')

case str-033

query T rowsort
SELECT substring('abcdef',2,3)

case str-034

query IIII rowsort
SELECT 'abc' LIKE 'ABC', 'abc' GLOB 'ABC', 'abc' LIKE 'a%', 'abc' GLOB 'a*'

