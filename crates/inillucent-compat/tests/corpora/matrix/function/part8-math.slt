# Moved from crates/inillucent-compat/tests/corpora/differential-part8/math.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

case mth-001

query IRRTT rowsort
SELECT abs(-3), abs(-3.5), abs('x'), abs(NULL), typeof(abs(-3))

case mth-002

query IIIT rowsort
SELECT sign(-3), sign(0), sign(4.5), sign('x')

case mth-003

query RRRRT rowsort
SELECT ceil(1.2), ceiling(-1.2), floor(1.8), floor(-1.8), typeof(ceil(1.2))

case mth-004

query RRT rowsort
SELECT trunc(1.9), trunc(-1.9), typeof(trunc(1.9))

case mth-005

query RTRRRR rowsort
SELECT sqrt(4), sqrt(-1), pow(2,10), power(2,0.5), exp(0), ln(1)

case mth-006

query RRRRTT rowsort
SELECT log(100), log10(100), log2(8), log(2,8), ln(0), ln(-1)

case mth-007

query RRRRRRRR rowsort
SELECT pi(), sin(0), cos(0), tan(0), asin(1), acos(1), atan(1), atan2(1,1)

case mth-008

query RRRRRR rowsort
SELECT sinh(0), cosh(0), tanh(0), asinh(0), acosh(1), atanh(0)

case mth-009

query RRRRR rowsort
SELECT degrees(pi()), radians(180), mod(7,2), mod(-7,2), mod(7.5,2)

case mth-010

query RRR rowsort
SELECT round(2.675,2), round(-2.675,2), round(1.005,2)

case mth-011

query TR rowsort
SELECT cast(sqrt(2) AS TEXT), 2.0/3.0

case mth-012

query IITT rowsort
SELECT max(1,2,3), min(1,2,3), max('a','B'), min('a','B')

