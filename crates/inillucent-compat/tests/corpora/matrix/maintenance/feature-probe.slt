# Copied from tools/feature-probe/cases.js and cases-extra.js, which stay as the
# published comparison. Dot commands and shell settings are left out: the matrix
# compares typed values through the engine, not what the shell prints.

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

case probe-xp.scan

query IIIT rowsort
EXPLAIN QUERY PLAN SELECT * FROM t WHERE b='q'

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE INDEX ia ON t(a)

case probe-xp.index

query IIIT rowsort
EXPLAIN QUERY PLAN SELECT id FROM t WHERE a=20

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE TABLE u(id INTEGER PRIMARY KEY, tid INTEGER, w TEXT)

statement ok
INSERT INTO u VALUES (1,1,'aa'),(2,2,'bb'),(3,9,'cc')

case probe-xp.join

query IIIT rowsort
EXPLAIN QUERY PLAN SELECT t.id FROM t JOIN u ON u.tid=t.id

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
