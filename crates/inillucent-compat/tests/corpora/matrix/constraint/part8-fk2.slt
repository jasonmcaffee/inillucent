# Moved from crates/inillucent-compat/tests/corpora/differential-part8/fk2.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

case dfk-001

statement ok
PRAGMA foreign_keys=ON

statement ok
CREATE TABLE p(id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE ch(pid INTEGER REFERENCES p(id))

statement ok
INSERT INTO p VALUES(1)

statement ok
INSERT INTO ch VALUES(1)

statement error
DROP TABLE p

