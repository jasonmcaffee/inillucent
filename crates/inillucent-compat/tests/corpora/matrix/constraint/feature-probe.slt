# Copied from tools/feature-probe/cases.js and cases-extra.js, which stay as the
# published comparison. Dot commands and shell settings are left out: the matrix
# compares typed values through the engine, not what the shell prints.

setup

statement ok
CREATE TABLE t(a INTEGER NOT NULL)

case probe-con.notnull

statement error
INSERT INTO t VALUES (NULL)

setup

statement ok
CREATE TABLE t(a INTEGER UNIQUE)

statement ok
INSERT INTO t VALUES (1)

case probe-con.unique

statement error
INSERT INTO t VALUES (1)

setup

statement ok
CREATE TABLE t(a INTEGER CHECK (a > 0))

statement ok
INSERT INTO t VALUES (5)

case probe-con.check.insert

statement error
INSERT INTO t VALUES (-5)

case probe-con.check.update

statement error
UPDATE t SET a=-1

setup

statement ok
CREATE TABLE t(a INTEGER, b INTEGER, CHECK (a < b))

statement ok
INSERT INTO t VALUES (1,2)

case probe-con.check.table

statement error
INSERT INTO t VALUES (5,2)

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY AUTOINCREMENT, a)

statement ok
INSERT INTO t(a) VALUES (1)

case probe-con.autoincrement

statement ok
DELETE FROM t

statement ok
INSERT INTO t(a) VALUES (2)

query I rowsort
SELECT id FROM t

query I rowsort
SELECT seq FROM sqlite_sequence WHERE name='t'

setup

statement ok
CREATE TABLE t(a TEXT UNIQUE ON CONFLICT IGNORE, b TEXT)

statement ok
INSERT INTO t VALUES ('x','1')

statement ok
INSERT INTO t VALUES ('x','2')

case probe-con.on.conflict.clause

query T rowsort
SELECT group_concat(a||b) FROM (SELECT a,b FROM t ORDER BY rowid)

setup

statement ok
CREATE TABLE t(a INTEGER, b TEXT NOT NULL ON CONFLICT REPLACE DEFAULT 'd')

statement ok
INSERT INTO t VALUES (1,NULL)

case probe-con.notnull.replace

query IT rowsort
SELECT a,b FROM t

setup

case probe-con.fk.immediate

statement ok
PRAGMA foreign_keys=ON

statement ok
CREATE TABLE p(id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p(id))

statement ok
INSERT INTO p VALUES (1)

statement ok
INSERT INTO ch VALUES (1,1)

statement error
INSERT INTO ch VALUES (2,9)

case probe-con.fk.cascade

statement ok
PRAGMA foreign_keys=ON

statement ok
CREATE TABLE p(id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p(id) ON DELETE CASCADE)

statement ok
INSERT INTO p VALUES (1),(2)

statement ok
INSERT INTO ch VALUES (1,1),(2,2)

statement ok
DELETE FROM p WHERE id=1

query I rowsort
SELECT count(*) FROM ch

case probe-con.fk.setnull

statement ok
PRAGMA foreign_keys=ON

statement ok
CREATE TABLE p(id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER DEFAULT 2 REFERENCES p(id) ON DELETE SET NULL)

statement ok
CREATE TABLE ch2(id INTEGER PRIMARY KEY, pid INTEGER DEFAULT 2 REFERENCES p(id) ON DELETE SET DEFAULT)

statement ok
INSERT INTO p VALUES (1),(2)

statement ok
INSERT INTO ch VALUES (1,1)

statement ok
INSERT INTO ch2 VALUES (1,1)

statement ok
DELETE FROM p WHERE id=1

query T rowsort
SELECT pid FROM ch

query I rowsort
SELECT pid FROM ch2

case probe-con.fk.update.cascade

statement ok
PRAGMA foreign_keys=ON

statement ok
CREATE TABLE p(id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p(id) ON UPDATE CASCADE)

statement ok
INSERT INTO p VALUES (1)

statement ok
INSERT INTO ch VALUES (1,1)

statement ok
UPDATE p SET id=5 WHERE id=1

query I rowsort
SELECT pid FROM ch

case probe-con.fk.deferred

statement ok
PRAGMA foreign_keys=ON

statement ok
CREATE TABLE p(id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p(id) DEFERRABLE INITIALLY DEFERRED)

statement ok
BEGIN

statement ok
INSERT INTO ch VALUES (1,1)

statement ok
INSERT INTO p VALUES (1)

statement ok
COMMIT

query I rowsort
SELECT count(*) FROM ch

