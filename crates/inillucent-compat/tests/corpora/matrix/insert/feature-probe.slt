setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, k TEXT UNIQUE, v INTEGER)

statement ok
INSERT INTO t VALUES (1,'a',1)

statement ok
INSERT INTO t VALUES (1,'b',2) ON CONFLICT(k) DO UPDATE SET v=9 ON CONFLICT(id) DO UPDATE SET v=8

case probe-upsert.two.clauses

query T rowsort
SELECT group_concat(id||k||v) FROM (SELECT id,k,v FROM t ORDER BY id)

