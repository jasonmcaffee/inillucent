setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, k TEXT UNIQUE, v INTEGER)

statement ok
INSERT INTO t VALUES (1,'a',1)

statement ok
INSERT INTO t VALUES (2,'a',2) ON CONFLICT(k) DO UPDATE SET v=v+excluded.v

case probe-upsert.secondary

query T rowsort
SELECT group_concat(id||k||v) FROM (SELECT id,k,v FROM t ORDER BY id)

