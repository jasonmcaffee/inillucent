# Moved from crates/inillucent-compat/tests/corpora/differential-part8/upsert.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER, w TEXT)

statement ok
INSERT INTO t VALUES(1,10,'a'),(2,20,'b')

statement ok
INSERT INTO t VALUES(1,99,'z') ON CONFLICT(id) DO UPDATE SET v=excluded.v

