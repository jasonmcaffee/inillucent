# Moved from crates/inillucent-compat/tests/corpora/differential-part8/todo.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

setup

statement ok
CREATE TABLE list (id INTEGER PRIMARY KEY, name TEXT)

statement ok
CREATE TABLE todo (id INTEGER PRIMARY KEY, list_id INTEGER, parent_id INTEGER, completed INTEGER, position INTEGER)

statement ok
INSERT INTO list VALUES (1, 'Home'), (2, 'Work'), (3, 'Empty')

statement ok
INSERT INTO todo VALUES (1, 1, NULL, 0, 1), (2, 1, NULL, 1, 2), (3, 2, NULL, 0, 1), (4, 1, 1, 0, 1), (5, 9, NULL, 0, 1)

case left-extra-on-noindex

query II nosort
SELECT l.id, t.id FROM list l LEFT JOIN todo t ON t.list_id = l.id AND t.parent_id IS NULL ORDER BY l.id, t.id

case left-extra-on-rowid-seek

query IT rowsort
SELECT t.id, l.name FROM todo t LEFT JOIN list l ON l.id = t.list_id AND l.name = 'Home' ORDER BY t.id

setup

statement ok
CREATE TABLE todo (id INTEGER PRIMARY KEY)

statement ok
CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT)

statement ok
CREATE TABLE todo_tag (todo_id INTEGER, tag_id INTEGER)

statement ok
INSERT INTO todo VALUES (1), (2), (3)

statement ok
INSERT INTO tag VALUES (1, 'b'), (2, 'a'), (3, 'c')

statement ok
INSERT INTO todo_tag VALUES (1, 1), (1, 2), (2, 3)

case correlated-derived-table

query IT rowsort
SELECT t.id, (SELECT json_group_array(name) FROM (SELECT g.name FROM todo_tag tt JOIN tag g ON g.id = tt.tag_id WHERE tt.todo_id = t.id ORDER BY g.name)) FROM todo t ORDER BY t.id

