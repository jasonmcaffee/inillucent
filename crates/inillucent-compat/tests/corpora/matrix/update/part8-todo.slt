statement ok
CREATE TABLE b (x, z)

statement ok
INSERT INTO b VALUES (1, 100), (2, 200), (3, 300)

statement ok
UPDATE todo SET position = b.z FROM a JOIN b USING (x) WHERE todo.id = x + 1

