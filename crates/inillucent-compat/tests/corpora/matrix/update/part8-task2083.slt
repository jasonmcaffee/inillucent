case ix-blob-ox-real

query TII rowsort
SELECT 'join', s.n, h.id FROM s, h WHERE h.a = s.k ORDER BY 2, 3

query TII rowsort
SELECT 'mirror', s.n, h.id FROM s, h WHERE s.k = h.a ORDER BY 2, 3

query TII rowsort
SELECT 'rowid', s.n, h.id FROM s, h WHERE h.id = s.k ORDER BY 2, 3

query TIII rowsort
SELECT 'correlated', n, (SELECT count(*) FROM h WHERE h.a = s.k), (SELECT sum(id) FROM h WHERE h.a = s.k) FROM s ORDER BY n

statement ok
UPDATE h SET b = b + 1 FROM s WHERE h.a = s.k

query TII rowsort
SELECT 'update', id, b FROM h ORDER BY id

