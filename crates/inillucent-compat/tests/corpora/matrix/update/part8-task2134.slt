# Moved from crates/inillucent-compat/tests/corpora/differential-part8/task2134.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

setup

statement ok
CREATE TABLE payment (id INTEGER PRIMARY KEY, at TEXT NOT NULL, business_day TEXT GENERATED ALWAYS AS (date(at)) VIRTUAL, amount INTEGER) STRICT

statement ok
INSERT INTO payment (at, amount) VALUES ('2026-09-20 10:00:00', 5), ('2026-09-21 09:00:00', 7)

statement ok
CREATE INDEX payment_day ON payment (business_day)

statement ok
INSERT INTO payment (at, amount) VALUES ('2026-09-20 18:00:00', 11), ('2026-09-22 08:00:00', 13)

case t2134-vgi-001

statement ok
UPDATE payment SET at = '2026-09-22 12:00:00' WHERE id = 2

statement ok
DELETE FROM payment WHERE id = 1

query ITI rowsort
SELECT id, business_day, amount FROM payment WHERE business_day = '2026-09-22' ORDER BY id

query TI rowsort
SELECT business_day, sum(amount) FROM payment GROUP BY business_day ORDER BY business_day

query T rowsort
PRAGMA integrity_check

