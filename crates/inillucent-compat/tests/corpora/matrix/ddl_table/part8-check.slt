# Moved from crates/inillucent-compat/tests/corpora/differential-part8/check.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

setup

statement ok
CREATE TABLE t(a CHECK(a>0))

statement ok
INSERT INTO t VALUES(1)

case chk-001

statement error
INSERT INTO t VALUES(-1)

setup

statement ok
CREATE TABLE t(a CHECK(a>0))

statement ok
INSERT INTO t VALUES(NULL)

case chk-002

query I rowsort
SELECT count(*) FROM t

setup

statement ok
CREATE TABLE t(a,b, CHECK(a<b))

statement ok
INSERT INTO t VALUES(1,2)

case chk-003

statement error
INSERT INTO t VALUES(2,1)

setup

statement ok
CREATE TABLE t(a TEXT CHECK(length(a)<3))

statement ok
INSERT INTO t VALUES('ab')

case chk-004

statement error
INSERT INTO t VALUES('abcd')

setup

statement ok
CREATE TABLE t(a CHECK(a IN (1,2)))

statement ok
INSERT INTO t VALUES(2)

case chk-005

statement error
INSERT INTO t VALUES(3)

setup

statement ok
CREATE TABLE t(a CHECK(a>0))

statement ok
INSERT INTO t VALUES(1)

case chk-006

statement error
UPDATE t SET a=-1

setup

statement ok
CREATE TABLE t(a INTEGER CHECK(a>0))

statement ok
INSERT INTO t VALUES('5')

case chk-007

query IT rowsort
SELECT a, typeof(a) FROM t

