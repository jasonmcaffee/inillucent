# Copied from tools/feature-probe/cases.js and cases-extra.js, which stay as the
# published comparison. Dot commands and shell settings are left out: the matrix
# compares typed values through the engine, not what the shell prints.

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

case probe-compound.union

query I nosort
SELECT a FROM t WHERE a<30 UNION SELECT a FROM t WHERE a>20 ORDER BY 1

case probe-compound.unionall

query I nosort
SELECT a FROM t WHERE a<30 UNION ALL SELECT a FROM t WHERE a>20 ORDER BY 1

case probe-compound.except

query I nosort
SELECT a FROM t EXCEPT SELECT a FROM t WHERE a>20 ORDER BY 1

case probe-compound.intersect

query I nosort
SELECT a FROM t WHERE a<40 INTERSECT SELECT a FROM t WHERE a>15 ORDER BY 1

case probe-compound.limit

query I nosort
SELECT a FROM t UNION ALL SELECT a FROM t ORDER BY a LIMIT 3

case probe-compound.three

query I nosort
SELECT 1 UNION SELECT 2 UNION ALL SELECT 3 ORDER BY 1

