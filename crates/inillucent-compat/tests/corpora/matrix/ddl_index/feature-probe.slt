# Copied from tools/feature-probe/cases.js and cases-extra.js, which stay as the
# published comparison. Dot commands and shell settings are left out: the matrix
# compares typed values through the engine, not what the shell prints.

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE INDEX ia ON t(a)

case probe-ddl.index.basic

query I rowsort
SELECT count(*) FROM t WHERE a=20

setup

statement ok
CREATE TABLE t(a)

statement ok
CREATE UNIQUE INDEX ia ON t(a)

statement ok
INSERT INTO t VALUES (1)

case probe-ddl.index.unique

statement error
INSERT INTO t VALUES (1)

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE INDEX ia ON t(a DESC)

case probe-ddl.index.desc

query I rowsort
SELECT count(*) FROM t WHERE a >= 20

query T rowsort
SELECT group_concat(a) FROM (SELECT a FROM t WHERE a > 15 ORDER BY a)

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE INDEX ia ON t(a) WHERE a > 15

case probe-ddl.index.partial

query I rowsort
SELECT count(*) FROM t WHERE a > 15

query T rowsort
SELECT sql FROM sqlite_schema WHERE name='ia'

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE INDEX ia ON t(a*2)

case probe-ddl.index.expr

query I rowsort
SELECT count(*) FROM t WHERE a*2 = 40

setup

statement ok
CREATE TABLE t(k TEXT PRIMARY KEY, v INTEGER) WITHOUT ROWID

statement ok
INSERT INTO t VALUES ('a',1),('b',2)

statement ok
CREATE INDEX iv ON t(v)

case probe-ddl.index.without.rowid

query T rowsort
SELECT k FROM t WHERE v=2

setup

statement ok
CREATE TABLE t(a TEXT)

statement ok
INSERT INTO t VALUES ('A'),('a'),('B')

statement ok
CREATE INDEX ia ON t(a COLLATE NOCASE)

case probe-ddl.index.collate

query T rowsort
SELECT group_concat(a) FROM (SELECT a FROM t WHERE a='a' COLLATE NOCASE ORDER BY rowid)

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE INDEX iab ON t(a,b)

case probe-ddl.index.composite

query I rowsort
SELECT id FROM t WHERE a=20 AND b='s'

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE INDEX ia ON t(a)

case probe-ddl.index.drop

statement ok
DROP INDEX ia

query I rowsort
SELECT count(*) FROM sqlite_schema WHERE name='ia'

case probe-ddl.index.reindex

statement ok
REINDEX

statement ok
REINDEX ia

query I rowsort
SELECT count(*) FROM t WHERE a=20

case probe-ddl.index.indexed.by

query I nosort
SELECT id FROM t INDEXED BY ia WHERE a=20 ORDER BY id

query I nosort
SELECT id FROM t NOT INDEXED WHERE a=20 ORDER BY id

case probe-ddl.index.analyze

statement ok
ANALYZE

query TT rowsort
SELECT tbl, idx FROM sqlite_stat1 ORDER BY idx

