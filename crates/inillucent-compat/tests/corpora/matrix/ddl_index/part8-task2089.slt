# Moved from crates/inillucent-compat/tests/corpora/differential-part8/task2089.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

setup

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE)

statement ok
INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C')

statement ok
CREATE INDEX t_sn ON t (s COLLATE NOCASE)

case collate-index-seek

query I nosort
SELECT id FROM t WHERE s = ('a' COLLATE NOCASE || '') ORDER BY id

case collate-indexed-by

query I nosort
SELECT id FROM t INDEXED BY t_sn WHERE s = ('a' COLLATE NOCASE || '') ORDER BY id

case collate-index-between

query I nosort
SELECT id FROM t WHERE s BETWEEN 'a' AND ('b' COLLATE NOCASE || '') ORDER BY id

