# Moved from crates/inillucent-compat/tests/corpora/differential-part8/task2088.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

setup

statement ok
CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE, i INTEGER)

statement ok
INSERT INTO t VALUES (1, 'a', 'a', 1), (2, 'B', 'B', 2), (3, 'c', 'c', 3), (4, 'A', 'A', 10), (5, 'b', 'b', 20), (6, 'C', 'C', 100)

statement ok
CREATE INDEX t_s ON t (s)

statement ok
CREATE INDEX t_sn ON t (s COLLATE NOCASE)

case between-index-high-nocase

query I nosort
SELECT id FROM t WHERE s BETWEEN 'a' AND 'B' COLLATE NOCASE ORDER BY id

case between-indexed-by-binary

query I nosort
SELECT id FROM t INDEXED BY t_s WHERE s BETWEEN 'a' AND 'B' COLLATE NOCASE ORDER BY id

case between-indexed-by-nocase-low

query I nosort
SELECT id FROM t INDEXED BY t_sn WHERE s BETWEEN 'A' COLLATE NOCASE AND 'b' ORDER BY id

case between-index-both-nocase

query I nosort
SELECT id FROM t INDEXED BY t_sn WHERE s BETWEEN 'a' COLLATE NOCASE AND 'B' COLLATE NOCASE ORDER BY id

case between-index-low-nocase

query I nosort
SELECT id FROM t WHERE s BETWEEN 'A' COLLATE NOCASE AND 'b' ORDER BY id

