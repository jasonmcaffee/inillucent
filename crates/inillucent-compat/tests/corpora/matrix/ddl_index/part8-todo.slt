# Moved from crates/inillucent-compat/tests/corpora/differential-part8/todo.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

setup

statement ok
CREATE TABLE list (id INTEGER PRIMARY KEY, name TEXT)

statement ok
CREATE TABLE todo (id INTEGER PRIMARY KEY, list_id INTEGER, parent_id INTEGER, completed INTEGER, position INTEGER)

statement ok
INSERT INTO list VALUES (1, 'Home'), (2, 'Work'), (3, 'Empty')

statement ok
INSERT INTO todo VALUES (1, 1, NULL, 0, 1), (2, 1, NULL, 1, 2), (3, 2, NULL, 0, 1), (4, 1, 1, 0, 1), (5, 9, NULL, 0, 1)

statement ok
CREATE INDEX todo_list ON todo (list_id)

case left-extra-on-isnull

query II nosort
SELECT l.id, t.id FROM list l LEFT JOIN todo t ON t.list_id = l.id AND t.parent_id IS NULL ORDER BY l.id, t.id

case left-extra-on-equal

query II nosort
SELECT l.id, t.id FROM list l LEFT JOIN todo t ON t.list_id = l.id AND t.completed = 0 ORDER BY l.id, t.id

