# Copied from tools/feature-probe/cases.js and cases-extra.js, which stay as the
# published comparison. Dot commands and shell settings are left out: the matrix
# compares typed values through the engine, not what the shell prints.

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

case probe-cte.simple

query I rowsort
WITH s AS (SELECT a FROM t WHERE a>15) SELECT count(*) FROM s

case probe-cte.multi

query T rowsort
WITH s AS (SELECT a FROM t), r AS (SELECT a FROM s WHERE a>20) SELECT group_concat(a) FROM (SELECT a FROM r ORDER BY a)

setup

case probe-cte.recursive

query T rowsort
WITH RECURSIVE n(x) AS (SELECT 1 UNION ALL SELECT x+1 FROM n WHERE x<10) SELECT group_concat(x) FROM n

setup

statement ok
CREATE TABLE org(id INTEGER PRIMARY KEY, parent INTEGER, name TEXT)

statement ok
INSERT INTO org VALUES (1,NULL,'a'),(2,1,'b'),(3,2,'c'),(4,1,'d')

case probe-cte.recursive.tree

query T rowsort
WITH RECURSIVE w(id,name,depth) AS (SELECT id,name,0 FROM org WHERE parent IS NULL UNION ALL SELECT o.id,o.name,w.depth+1 FROM org o JOIN w ON o.parent=w.id) SELECT group_concat(name || ':' || depth) FROM (SELECT name,depth FROM w ORDER BY id)

setup

case probe-cte.column.list

query I rowsort
WITH s(p,q) AS (SELECT 1,2) SELECT p+q FROM s

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

case probe-cte.materialized

query I rowsort
WITH s AS MATERIALIZED (SELECT a FROM t) SELECT count(*) FROM s

query I rowsort
WITH r AS NOT MATERIALIZED (SELECT a FROM t) SELECT count(*) FROM r

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE TABLE d(a INTEGER)

case probe-cte.on.insert

statement ok
WITH s AS (SELECT a FROM t WHERE a>20) INSERT INTO d SELECT a FROM s

query T rowsort
SELECT group_concat(a) FROM (SELECT a FROM d ORDER BY a)

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

case probe-cte.on.dml

statement ok
WITH s AS (SELECT id FROM t WHERE a=20) UPDATE t SET b='z' WHERE id IN (SELECT id FROM s)

statement ok
WITH s AS (SELECT id FROM t WHERE a=50) DELETE FROM t WHERE id IN (SELECT id FROM s)

query T rowsort
SELECT group_concat(id || b) FROM (SELECT id,b FROM t ORDER BY id)

