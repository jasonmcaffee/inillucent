# Copied from tools/feature-probe/cases.js and cases-extra.js, which stay as the
# published comparison. Dot commands and shell settings are left out: the matrix
# compares typed values through the engine, not what the shell prints.

case probe-att.basic

statement ok
ATTACH DATABASE '%SCRATCH%/second.db' AS s

statement ok
CREATE TABLE s.x(a)

statement ok
INSERT INTO s.x VALUES (1),(2)

query I rowsort
SELECT count(*) FROM s.x

statement ok
DETACH DATABASE s

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

case probe-att.join

statement ok
ATTACH DATABASE '%SCRATCH%/second.db' AS s

statement ok
CREATE TABLE s.x(id INTEGER, w TEXT)

statement ok
INSERT INTO s.x VALUES (1,'aa'),(2,'bb')

query T rowsort
SELECT group_concat(i||w) FROM (SELECT t.id AS i, x.w AS w FROM t JOIN s.x x ON x.id=t.id ORDER BY t.id)

setup

case probe-att.txn

statement ok
ATTACH DATABASE '%SCRATCH%/second.db' AS s

statement ok
CREATE TABLE main.a(x)

statement ok
CREATE TABLE s.b(x)

statement ok
BEGIN

statement ok
INSERT INTO main.a VALUES (1)

statement ok
INSERT INTO s.b VALUES (1)

statement ok
COMMIT

query I rowsort
SELECT (SELECT count(*) FROM main.a) + (SELECT count(*) FROM s.b)

case probe-att.rollback

statement ok
ATTACH DATABASE '%SCRATCH%/second.db' AS s

statement ok
CREATE TABLE main.a(x)

statement ok
CREATE TABLE s.b(x)

statement ok
BEGIN

statement ok
INSERT INTO main.a VALUES (1)

statement ok
INSERT INTO s.b VALUES (1)

statement ok
ROLLBACK

query I rowsort
SELECT (SELECT count(*) FROM main.a) + (SELECT count(*) FROM s.b)

case probe-att.memory

statement ok
ATTACH DATABASE ':memory:' AS m

statement ok
CREATE TABLE m.x(a)

statement ok
INSERT INTO m.x VALUES (1)

query I rowsort
SELECT count(*) FROM m.x

case probe-att.database.list

statement ok
ATTACH DATABASE '%SCRATCH%/second.db' AS s

query I rowsort
SELECT count(*) FROM pragma_database_list

case probe-temp.table

statement ok
CREATE TEMP TABLE tt(a)

statement ok
INSERT INTO tt VALUES (1),(2)

query I rowsort
SELECT count(*) FROM tt

query I rowsort
SELECT count(*) FROM temp.tt

setup

statement ok
CREATE TABLE t(a)

case probe-temp.view.trigger

statement ok
CREATE TEMP VIEW v AS SELECT a FROM t

statement ok
CREATE TEMP TRIGGER tg AFTER INSERT ON t BEGIN SELECT 1; END

statement ok
INSERT INTO t VALUES (1)

query I rowsort
SELECT count(*) FROM v

setup

case probe-temp.not.main

statement ok
CREATE TEMP TABLE tt(a)

query I rowsort
SELECT count(*) FROM sqlite_schema WHERE name='tt'

query I rowsort
SELECT count(*) FROM sqlite_temp_schema WHERE name='tt'

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

case probe-temp.as.select

statement ok
CREATE TEMP TABLE tt AS SELECT a FROM t WHERE a>15

query I rowsort
SELECT count(*) FROM tt

case probe-temp.shadow

statement ok
CREATE TEMP TABLE t(z)

statement ok
INSERT INTO t VALUES (1)

query I rowsort
SELECT count(*) FROM t

query I rowsort
SELECT count(*) FROM main.t

case probe-sch.schema.table

query TT rowsort
SELECT type, name FROM sqlite_schema ORDER BY name

query I rowsort
SELECT count(*) FROM sqlite_master

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE INDEX ia ON t(a)

statement ok
CREATE TRIGGER tg AFTER INSERT ON t BEGIN SELECT 1; END

case probe-sch.schema.sql

query TTT rowsort
SELECT type, name, sql FROM sqlite_schema WHERE type IN ('index','trigger') ORDER BY name

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

case probe-sch.vacuum

statement ok
DELETE FROM t WHERE id<3

statement ok
VACUUM

query I rowsort
SELECT count(*) FROM t

case probe-sch.vacuum.into

statement ok
VACUUM INTO '%SCRATCH%/copy.db'

query I rowsort
SELECT count(*) FROM t

setup

statement ok
CREATE TABLE t(a)

statement ok
INSERT INTO t VALUES ('x')

case probe-sch.rowid.aliases

query III rowsort
SELECT rowid, oid, _rowid_ FROM t

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY AUTOINCREMENT, a)

statement ok
INSERT INTO t(a) VALUES (1),(2)

case probe-sch.sqlite.sequence

query TI rowsort
SELECT name, seq FROM sqlite_sequence

