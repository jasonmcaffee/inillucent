# Moved from crates/inillucent-compat/tests/corpora/differential-part8/groupby.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

setup

statement ok
CREATE TABLE t(g,v)

statement ok
INSERT INTO t VALUES('a',1),('a',2),('b',3),('b',4)

case gb-001

query T nosort
SELECT g FROM t GROUP BY g ORDER BY g

case gb-002

query TI rowsort
SELECT g, v FROM t GROUP BY g ORDER BY g

case gb-003

query T nosort
SELECT g FROM t GROUP BY g HAVING count(*)>0 ORDER BY g

case gb-004

query TI rowsort
SELECT g, count(*) FROM t GROUP BY g ORDER BY g

case gb-005

query T nosort
SELECT upper(g) FROM t GROUP BY g ORDER BY 1

case gb-006

query T nosort
SELECT g||'!' FROM t GROUP BY g ORDER BY 1

case gb-007

query TT rowsort
SELECT g, g FROM t GROUP BY g ORDER BY 1

case gb-008

query T nosort
SELECT g FROM t GROUP BY 1 ORDER BY 1

case gb-009

query TI nosort
SELECT g, v FROM t GROUP BY g, v ORDER BY g, v

case gb-010

query I nosort
SELECT v FROM t GROUP BY v ORDER BY v

case gb-011

query I rowsort
SELECT 1 FROM t GROUP BY g

case gb-012

query T rowsort
SELECT g FROM t GROUP BY g HAVING g>'a'

case gb-013

query T nosort
SELECT g FROM t WHERE v>1 GROUP BY g ORDER BY g

case gb-014

query I rowsort
SELECT count(*) FROM (SELECT g FROM t GROUP BY g)

case gb-015

query T nosort
SELECT g FROM t GROUP BY g ORDER BY v

case gb-016

query T nosort
SELECT g FROM t GROUP BY g||'' ORDER BY 1

case gb-017

query T nosort
SELECT DISTINCT g FROM t ORDER BY g

setup

statement ok
CREATE TABLE t(g,v)

statement ok
INSERT INTO t VALUES('a',1),('a',2),('b',3),('b',4)

statement ok
CREATE INDEX i ON t(g)

case gb-018

query T nosort
SELECT g FROM t GROUP BY g ORDER BY g

setup

statement ok
CREATE TABLE t(g,v)

statement ok
INSERT INTO t VALUES('a',1),('a',2),('b',3),('b',4)

case gb-019

query T rowsort
SELECT g FROM t GROUP BY g LIMIT 1

case gb-020

query T nosort
SELECT t.g FROM t GROUP BY t.g ORDER BY t.g

case gb-021

query T nosort
SELECT g AS k FROM t GROUP BY k ORDER BY k

case gb-022

query T rowsort
SELECT g FROM t GROUP BY g UNION ALL SELECT 'z'

case gb-023

query TI rowsort
SELECT g, (SELECT count(*) FROM t u WHERE u.g=t.g) FROM t GROUP BY g ORDER BY g

case gb-024

query I nosort
SELECT rowid FROM t GROUP BY rowid ORDER BY rowid

case gb-025

query T nosort
SELECT g FROM t GROUP BY g, v ORDER BY g, v

