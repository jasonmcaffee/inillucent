case agg-017

query TI rowsort
SELECT g, count(*) FROM t GROUP BY 1 ORDER BY 1

case agg-018

query TI rowsort
SELECT upper(g) AS u, count(*) FROM t GROUP BY u ORDER BY u

setup

case agg-019

query T rowsort
SELECT group_concat(a,'') FROM (SELECT 'x' AS a UNION ALL SELECT 'y')

