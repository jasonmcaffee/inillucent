query IT rowsort
SELECT * FROM t

setup

statement ok
CREATE TABLE t(a)

statement ok
CREATE TABLE log(m)

statement ok
CREATE TRIGGER tr AFTER INSERT ON t BEGIN INSERT INTO log VALUES(last_insert_rowid()); END

statement ok
