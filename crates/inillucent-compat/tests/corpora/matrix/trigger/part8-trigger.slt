# Moved from crates/inillucent-compat/tests/corpora/differential-part8/trigger.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

setup

statement ok
CREATE TABLE t(a)

statement ok
CREATE TABLE log(m)

statement ok
CREATE TRIGGER tr AFTER INSERT ON t BEGIN INSERT INTO log VALUES('ins '||NEW.a); END

statement ok
INSERT INTO t VALUES(1),(2)

case trg-001

query T rowsort
SELECT * FROM log

setup

statement ok
CREATE TABLE t(a)

statement ok
CREATE TABLE log(m)

statement ok
CREATE TRIGGER tr BEFORE DELETE ON t BEGIN INSERT INTO log VALUES('del '||OLD.a); END

statement ok
INSERT INTO t VALUES(1)

case trg-002

statement ok
DELETE FROM t

query T rowsort
SELECT * FROM log

setup

statement ok
CREATE TABLE t(a)

statement ok
CREATE TABLE log(m)

statement ok
CREATE TRIGGER tr AFTER UPDATE OF a ON t BEGIN INSERT INTO log VALUES(OLD.a||'->'||NEW.a); END

statement ok
INSERT INTO t VALUES(1)

case trg-003

statement ok
UPDATE t SET a=2

query T rowsort
SELECT * FROM log

setup

statement ok
CREATE TABLE t(a)

statement ok
CREATE TRIGGER tr BEFORE INSERT ON t WHEN NEW.a<0 BEGIN SELECT RAISE(ABORT,'negative'); END

statement ok
INSERT INTO t VALUES(1)

case trg-004

statement error
INSERT INTO t VALUES(-1)

setup

statement ok
CREATE TABLE t(a)

statement ok
CREATE TRIGGER tr BEFORE INSERT ON t WHEN NEW.a<0 BEGIN SELECT RAISE(IGNORE); END

statement ok
INSERT INTO t VALUES(1),(-1),(2)

case trg-005

query I rowsort
SELECT * FROM t

setup

statement ok
CREATE TABLE t(a)

statement ok
CREATE VIEW v AS SELECT * FROM t

statement ok
CREATE TRIGGER tr INSTEAD OF INSERT ON v BEGIN INSERT INTO t VALUES(NEW.a*2); END

statement ok
INSERT INTO v VALUES(5)

case trg-006

query I rowsort
SELECT * FROM t

setup

statement ok
CREATE TABLE t(a)

statement ok
CREATE TABLE log(m)

statement ok
CREATE TRIGGER tr AFTER INSERT ON t FOR EACH ROW BEGIN INSERT INTO log VALUES(changes()); END

statement ok
INSERT INTO t VALUES(1)

case trg-007

query I rowsort
SELECT * FROM log

setup

statement ok
CREATE TABLE t(a INTEGER PRIMARY KEY, b)

statement ok
CREATE TRIGGER tr AFTER INSERT ON t BEGIN UPDATE t SET b='set' WHERE a=NEW.a; END

statement ok
INSERT INTO t(b) VALUES('x')

