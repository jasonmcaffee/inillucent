setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE TABLE log(m TEXT)

statement ok
CREATE TRIGGER tu AFTER UPDATE OF b ON t BEGIN INSERT INTO log VALUES ('b'); END

case probe-trg.update.of

statement ok
UPDATE t SET a=1 WHERE id=1

statement ok
UPDATE t SET b='z' WHERE id=1

