setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE TRIGGER ti BEFORE INSERT ON t BEGIN SELECT RAISE(ABORT,'nope') WHERE new.a < 0; END

case probe-trg.raise.abort

statement error
INSERT INTO t VALUES (6,-1,'u')

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE TRIGGER ti BEFORE INSERT ON t BEGIN SELECT RAISE(IGNORE) WHERE new.a < 0; END

statement ok
INSERT INTO t VALUES (6,-1,'u')

case probe-trg.raise.ignore

query I rowsort
SELECT count(*) FROM t

setup

case probe-trg.recursive

statement ok
PRAGMA recursive_triggers=ON

statement ok
CREATE TABLE t(a INTEGER)

statement ok
CREATE TABLE log(m INTEGER)

statement ok
CREATE TRIGGER ti AFTER INSERT ON t WHEN new.a < 5 BEGIN INSERT INTO t VALUES (new.a+1); END

statement ok
INSERT INTO t VALUES (1)

query I rowsort
SELECT count(*) FROM t

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
