statement ok
CREATE TRIGGER ti AFTER INSERT ON t BEGIN SELECT 1; END

case probe-trg.drop

statement ok
DROP TRIGGER ti

query I rowsort
SELECT count(*) FROM sqlite_schema WHERE type='trigger'

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE TABLE u(id INTEGER PRIMARY KEY, tid INTEGER, w TEXT)

statement ok
INSERT INTO u VALUES (1,1,'aa'),(2,2,'bb'),(3,9,'cc')

statement ok
CREATE TRIGGER td AFTER DELETE ON t BEGIN DELETE FROM u WHERE tid = old.id; END

case probe-trg.cascade

statement ok
DELETE FROM t WHERE id=1

query I rowsort
