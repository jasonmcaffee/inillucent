# Copied from tools/feature-probe/cases.js and cases-extra.js, which stay as the
# published comparison. Dot commands and shell settings are left out: the matrix
# compares typed values through the engine, not what the shell prints.

setup

statement ok
CREATE TABLE t(a INTEGER)

statement ok
INSERT INTO t VALUES ('42'),('abc'),(1.0)

case probe-types.affinity.int

query TI rowsort
SELECT typeof(a), a FROM t

setup

statement ok
CREATE TABLE t(a TEXT)

statement ok
INSERT INTO t VALUES (42),(1.5)

case probe-types.affinity.text

query TT rowsort
SELECT typeof(a), a FROM t

setup

statement ok
CREATE TABLE t(a REAL)

statement ok
INSERT INTO t VALUES (1),(2.5),('3')

case probe-types.affinity.real

query TR rowsort
SELECT typeof(a), a FROM t

setup

statement ok
CREATE TABLE t(a BLOB)

statement ok
INSERT INTO t VALUES (1),('x'),(x'4142')

case probe-types.affinity.blob

query TT rowsort
SELECT typeof(a), quote(a) FROM t

setup

statement ok
CREATE TABLE t(a NUMERIC)

statement ok
INSERT INTO t VALUES ('42'),('4.5'),('abc'),(7)

case probe-types.affinity.numeric

query TI rowsort
SELECT typeof(a), a FROM t

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a)

statement ok
INSERT INTO t VALUES ('42','x')

case probe-types.affinity.rowid

query IT rowsort
SELECT id, typeof(id) FROM t

setup

case probe-types.cast

query IIITRTT rowsort
SELECT CAST('42abc' AS INTEGER), CAST('3.9' AS INTEGER), CAST(3.9 AS INTEGER), CAST(42 AS TEXT), CAST('abc' AS REAL), typeof(CAST(1 AS BLOB)), CAST(x'4142' AS TEXT)

case probe-types.compare.classes

query IITII rowsort
SELECT 1 < 'a', 'a' < x'00', NULL < 1, 2 < 10, '2' < '10'

case probe-types.int.overflow

query RTII rowsort
SELECT 9223372036854775807 + 1, typeof(9223372036854775807 + 1), 9223372036854775807, -9223372036854775808

case probe-types.real.format

query RRRRRR rowsort
SELECT 1.0, 0.1+0.2, 1e300*1e300, 1.0/3.0, 2.0, -0.0

case probe-types.int.division

query IIIIRTT rowsort
SELECT 7/2, -7/2, 7%3, -7%3, 7.0/2, 1/0, 1%0

case probe-types.hex

query IITIT rowsort
SELECT 0x10, 0xFF, quote(x'0011ff'), length(x'0011ff'), hex(x'0011ff')

case probe-types.boolean

query IIIIT rowsort
SELECT TRUE, FALSE, TRUE AND FALSE, NULL IS NULL, typeof(TRUE)

setup

statement ok
CREATE TABLE t(a TEXT)

statement ok
INSERT INTO t VALUES ('café 日本語 🚀')

case probe-types.unicode

query TIIT rowsort
SELECT a, length(a), octet_length(a), upper(a) FROM t

setup

case probe-types.null

query TTTIIT rowsort
SELECT NULL+1, NULL||'a', NULL=NULL, NULL IS NULL, coalesce(NULL,2), max(NULL,1)

setup

statement ok
CREATE TABLE t(a TEXT)

statement ok
INSERT INTO t VALUES (hex(zeroblob(200000)))

case probe-types.large.value

query IT rowsort
SELECT length(a), substr(a,1,4) FROM t

setup

statement ok
CREATE TABLE t(a BLOB)

statement ok
INSERT INTO t VALUES (zeroblob(200000))

case probe-types.large.blob

query IT rowsort
SELECT length(a), typeof(a) FROM t

setup

case probe-op.arith

query IIITII rowsort
SELECT 1+2, 3-4, 5*6, 'a'||'b'||1, -(-3), +4

case probe-op.bitwise

query IIIII rowsort
SELECT 6 & 3, 6 | 3, 6 << 2, 6 >> 1, ~6

case probe-op.is

query IIIII rowsort
SELECT 1 IS 1, NULL IS NULL, 1 IS NOT NULL, 1 IS DISTINCT FROM NULL, 1 IS NOT DISTINCT FROM 1

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

case probe-op.between

query T rowsort
SELECT group_concat(a) FROM (SELECT a FROM t WHERE a BETWEEN 20 AND 30 ORDER BY a)

query I rowsort
SELECT count(*) FROM t WHERE a NOT BETWEEN 20 AND 30

case probe-op.in.list

query I rowsort
SELECT count(*) FROM t WHERE a IN (10,20,999)

query I rowsort
SELECT count(*) FROM t WHERE a NOT IN (10,20)

setup

case probe-op.like

query IIIII rowsort
SELECT 'abc' LIKE 'a%', 'ABC' LIKE 'a%', 'a_c' LIKE 'a\_c' ESCAPE '\', 'axc' LIKE 'a\_c' ESCAPE '\', 'abc' LIKE 'A_C'

case probe-op.glob

query IIII rowsort
SELECT 'abc' GLOB 'a*', 'ABC' GLOB 'a*', 'abc' GLOB 'a[bx]c', 'abc' GLOB '?bc'

case probe-op.regexp

statement error
SELECT 'abc' REGEXP 'a.c'

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

case probe-op.case

query ITT rowsort
SELECT id, CASE WHEN a>25 THEN 'big' ELSE 'small' END, CASE a WHEN 10 THEN 'ten' ELSE 'other' END FROM t ORDER BY id

setup

case probe-op.json.arrow

query IIT rowsort
SELECT '{"a":{"b":2}}' -> '$.a' ->> '$.b', '[1,2,3]' ->> 1, typeof('{"a":1}' -> '$.a')

case probe-op.precedence

query IIIII rowsort
SELECT 2+3*4, (2+3)*4, NOT 0 AND 1, 1 OR 0 AND 0, 1 < 2 = 1

case probe-op.string.compare

query IIII rowsort
SELECT 'a' < 'b', 'A' < 'a', 'a' = 'A', 'a' = 'A' COLLATE NOCASE

case probe-coll.builtin

query III rowsort
SELECT 'a'='A' COLLATE BINARY, 'a'='A' COLLATE NOCASE, 'a '='a' COLLATE RTRIM

setup

statement ok
CREATE TABLE t(a TEXT COLLATE NOCASE)

statement ok
INSERT INTO t VALUES ('A'),('a')

case probe-coll.column

query I rowsort
SELECT count(*) FROM t WHERE a='a'

setup

statement ok
CREATE TABLE t(a TEXT)

statement ok
INSERT INTO t VALUES ('B'),('a'),('A'),('b')

case probe-coll.orderby

query T rowsort
SELECT group_concat(a) FROM (SELECT a FROM t ORDER BY a COLLATE NOCASE, a)

setup

statement ok
CREATE TABLE t(a TEXT COLLATE NOCASE UNIQUE)

statement ok
