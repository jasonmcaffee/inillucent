# Moved from crates/inillucent-compat/tests/corpora/differential-part8/affinity.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

case aff-001

query IIIIT rowsort
SELECT '10' < 9, '10' < '9', 10 < '9', '10' = 10, typeof('10'+0)

setup

statement ok
CREATE TABLE t(a INTEGER)

statement ok
INSERT INTO t VALUES('10'),('9')

case aff-002

query IT rowsort
SELECT a, typeof(a) FROM t ORDER BY a

setup

statement ok
CREATE TABLE t(a TEXT)

statement ok
INSERT INTO t VALUES(10),(9)

case aff-003

query TT rowsort
SELECT a, typeof(a) FROM t ORDER BY a

setup

statement ok
CREATE TABLE t(a TEXT)

statement ok
INSERT INTO t VALUES('10'),('9')

case aff-004

query T nosort
SELECT a FROM t WHERE a < 9 ORDER BY a

setup

statement ok
CREATE TABLE t(a INTEGER)

statement ok
INSERT INTO t VALUES('abc')

