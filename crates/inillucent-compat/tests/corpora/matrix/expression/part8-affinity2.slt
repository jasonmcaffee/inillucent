# Moved from crates/inillucent-compat/tests/corpora/differential-part8/affinity2.cases,
# where each case was one line run through both shells with -bail. Each case now runs
# on files through the persistent oracle, and stops where the script stopped.

setup

statement ok
CREATE TABLE t(n, i INTEGER, r REAL, s TEXT, b BLOB, m NUMERIC)

statement ok
INSERT INTO t VALUES(1,1,1,'1',1,1)

case cma-001

query IIIII rowsort
SELECT n=i, n=r, n=s, n=b, n=m FROM t

case cma-002

query IIIII rowsort
SELECT i=s, r=s, m=s, b=s, s=b FROM t

case cma-003

query IIIII rowsort
SELECT i=n, s=n, s=i, s=r, s=m FROM t

setup

statement ok
CREATE TABLE t(a,b TEXT)

statement ok
INSERT INTO t VALUES(1,'1')

case cma-004

query IIIIII rowsort
SELECT a=b, a<b, a>b, a<=b, a>=b, a<>b FROM t

setup

statement ok
CREATE TABLE t(a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES(1,'1')

case cma-005

query IIII rowsort
SELECT a=b, a<b, a>b, a<>b FROM t

setup

statement ok
CREATE TABLE t(a INTEGER, b TEXT)

statement ok
