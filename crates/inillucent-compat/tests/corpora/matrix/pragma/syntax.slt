# Every example in compat/syntax.toml, run rather than only parsed. The setup below
# is shared by every case in the file; a case's first records are its production's
# prelude. Written by `inillucent-matrix convert-syntax`.

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a, b, c)

statement ok
INSERT INTO t VALUES(1, 1, 2, 3), (2, 2, 3, 4), (3, NULL, 'x', x'00')

statement ok
CREATE TABLE u(id INTEGER PRIMARY KEY, a, b UNIQUE, c)

statement ok
INSERT INTO u VALUES(1, 5, 6, 7), (2, 6, 7, 8)

statement ok
CREATE TABLE a(x, y)

statement ok
INSERT INTO a VALUES(1, 2), (2, 3)

statement ok
CREATE TABLE b(x, y)

statement ok
INSERT INTO b VALUES(2, 3), (4, 5)

statement ok
CREATE TABLE c(x, y)

statement ok
INSERT INTO c VALUES(1, 1)

statement ok
CREATE VIEW v AS SELECT a, b, c FROM t

statement ok
CREATE INDEX i ON t(a)

statement ok
CREATE TRIGGER tr AFTER INSERT ON u BEGIN SELECT 1; END

case syntax-pragma-stmt-p0

query I rowsort
PRAGMA page_size

case syntax-pragma-stmt-p1

statement ok
PRAGMA main.page_size = 4096

case syntax-pragma-stmt-p2

query T rowsort
PRAGMA journal_mode = WAL

case syntax-pragma-stmt-p3

query ITTITI rowsort
PRAGMA table_info(t)

case syntax-pragma-stmt-p4

statement ok
PRAGMA foreign_keys(1)

case syntax-pragma-stmt-n5

statement error
PRAGMA

case syntax-signed-number-p0

statement ok
PRAGMA cache_size = -2000

case syntax-signed-number-p1

statement ok
PRAGMA cache_size = 2000

case syntax-signed-number-p2

statement ok
PRAGMA cache_size = +1

