# Copied from tools/feature-probe/cases.js and cases-extra.js, which stay as the
# published comparison. Dot commands and shell settings are left out: the matrix
# compares typed values through the engine, not what the shell prints.

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE VIEW v AS SELECT a FROM t WHERE a>15

case probe-ddl.view.basic

query I rowsort
SELECT count(*) FROM v

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE VIEW v(x) AS SELECT a FROM t

case probe-ddl.view.columns

query T rowsort
SELECT group_concat(x) FROM (SELECT x FROM v ORDER BY x)

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE VIEW v AS SELECT a FROM t

case probe-ddl.view.drop

statement ok
DROP VIEW v

query I rowsort
SELECT count(*) FROM sqlite_schema WHERE name='v'

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE VIEW v AS SELECT id,a FROM t

statement ok
CREATE TRIGGER vi INSTEAD OF INSERT ON v BEGIN INSERT INTO t(id,a,b) VALUES (new.id,new.a,'via'); END

statement ok
INSERT INTO v VALUES (9,90)

case probe-ddl.view.instead.of

query IIT rowsort
SELECT id,a,b FROM t WHERE id=9

setup

statement ok
CREATE TABLE t(id INTEGER PRIMARY KEY, a INTEGER, b TEXT)

statement ok
INSERT INTO t VALUES (1,10,'p'),(2,20,'q'),(3,30,'r'),(4,20,'s'),(5,50,'t')

statement ok
CREATE TABLE u(id INTEGER PRIMARY KEY, tid INTEGER, w TEXT)

statement ok
INSERT INTO u VALUES (1,1,'aa'),(2,2,'bb'),(3,9,'cc')

statement ok
CREATE VIEW v AS SELECT t.id, u.w FROM t JOIN u ON u.tid=t.id

case probe-ddl.view.join

query T rowsort
SELECT group_concat(id||w) FROM (SELECT id,w FROM v ORDER BY id)

