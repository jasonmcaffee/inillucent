# Differential cases, category `json`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential_part8.rs`; nothing else parses this.
js-001	SELECT json_extract('{"a":1,"b":[1,2]}','$.a'), json_extract('{"a":1}','$.b'), json_extract('[1,2,3]','$[1]')
js-002	SELECT json_extract('{"a":1,"b":2}','$.a','$.b'), typeof(json_extract('{"a":1}','$.a'))
js-003	SELECT json_array(1,'a',NULL,2.5), json_object('a',1,'b','x'), json_array_length('[1,2,3]')
js-004	SELECT json_valid('{"a":1}'), json_valid('{'), json_valid('1'), json_valid(NULL)
js-005	SELECT json_type('{"a":1}'), json_type('{"a":1}','$.a'), json_type('[1]','$[0]')
js-006	SELECT json('{ "a" : 1 }'), json_quote('a'), json_quote(1)
js-007	SELECT key, value, type FROM json_each('{"a":1,"b":"x"}') ORDER BY key
js-008	SELECT fullkey, path, atom FROM json_tree('{"a":[1]}') ORDER BY fullkey
js-009	SELECT '{"a":1}' -> '$.a', '{"a":1}' ->> '$.a', typeof('{"a":1}' -> '$.a'), typeof('{"a":1}' ->> '$.a')
js-010	SELECT '[1,2]' -> 0, '[1,2]' ->> 1, '{"a":1}' -> 'a'
js-011	SELECT json_insert('{"a":1}','$.b',2), json_replace('{"a":1}','$.a',9), json_set('{"a":1}','$.a',9,'$.b',3)
js-012	SELECT json_remove('{"a":1,"b":2}','$.a'), json_patch('{"a":1}','{"b":2}')
js-013	SELECT json_group_array(a), json_group_object(a,b) FROM (SELECT 'x' AS a, 1 AS b UNION ALL SELECT 'y', 2)
js-014	SELECT json_extract('{"a":"x"}','$.a'), json_extract('{"a":[1]}','$.a'), json_extract('{"a":null}','$.a')
js-015	SELECT json_array_length('{"a":1}'), json_array_length('[1,2]','$'), json_array_length('[[1,2]]','$[0]')
js-016	SELECT json_error_position('{"a":}'), json_valid('[1,]')
js-017	SELECT value FROM json_each('[10,20,30]') ORDER BY value
js-018	SELECT json_object('a',json_array(1,2)), json_object('a',json('[1,2]'))
js-019	SELECT json_extract('[1,2,3]','$[#-1]'), json_extract('{"a":{"b":2}}','$.a.b')
js-020	SELECT json_pretty('{"a":1}')
