# Differential cases, category `compound`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential_part8.rs`; nothing else parses this.
cmp-001	SELECT 1 UNION SELECT 1 UNION SELECT 2
cmp-002	SELECT 1 UNION ALL SELECT 1 UNION ALL SELECT 2
cmp-003	SELECT 1 AS a UNION SELECT 1.0
cmp-004	SELECT 1 AS a UNION SELECT '1'
cmp-005	SELECT 2 AS a UNION SELECT 1 ORDER BY a DESC
cmp-006	SELECT 3 AS a UNION SELECT 1 UNION SELECT 2 ORDER BY 1 LIMIT 2
cmp-007	SELECT 1,2 INTERSECT SELECT 1,2
cmp-008	CREATE TABLE t(a); INSERT INTO t VALUES(1),(2),(3); SELECT a FROM t EXCEPT SELECT 2 ORDER BY a
cmp-009	CREATE TABLE t(a); INSERT INTO t VALUES(NULL),(1); SELECT a FROM t INTERSECT SELECT NULL
cmp-010	CREATE TABLE t(a); INSERT INTO t VALUES(NULL),(1); SELECT a FROM t EXCEPT SELECT NULL
cmp-011	SELECT 1 UNION SELECT 1,2
cmp-012	SELECT 1 AS a ORDER BY b
cmp-013	SELECT 1 AS a UNION SELECT 2 ORDER BY x
cmp-014	SELECT 'b' AS a UNION SELECT 'a' ORDER BY a COLLATE NOCASE
cmp-015	CREATE TABLE t(a TEXT COLLATE NOCASE); INSERT INTO t VALUES('A'); SELECT a FROM t UNION SELECT 'a'
cmp-016	SELECT 1 EXCEPT SELECT 1 UNION SELECT 2
cmp-017	SELECT 1 AS x UNION ALL SELECT 2 ORDER BY x LIMIT 1 OFFSET 1
cmp-018	VALUES(1,2),(3,4)
cmp-019	SELECT * FROM (VALUES(1),(2)) ORDER BY 1 DESC
cmp-020	SELECT 1 AS a UNION ALL SELECT 2 AS b ORDER BY a
