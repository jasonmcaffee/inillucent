# Differential cases, category `task2089`: an explicit COLLATE inside an operand reaches the comparison.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential/differential_part8.rs`; nothing else parses this.
#
# task-2089: SQLite marks an expression EP_Collate when any operand carries an explicit COLLATE,
# and sqlite3ExprCollSeq reads the collation from the first marked operand, left first. A CAST and
# a unary + pass a column's own collation through as well. BoundExpr::explicit_collation and
# BoundExpr::collation looked only at the top node, and the executor's expression_collation, which
# GROUP BY, DISTINCT and PARTITION BY use, was a third copy of the same rule. A column's declared
# collation does not pass through `||`, and a COLLATE does not come out of a scalar subquery:
# collate-implicit-not-through-concat and collate-scalar-subquery agreed before and are here so the
# fix cannot overshoot, and so are collate-outer-wins, collate-concat-column-binary and
# collate-index-between, which also agreed before. The build before task-2088 disagreed with SQLite
# on the other 21 of these 28 cases. collate-aggregate-result and collate-case-base-when were left
# disagreeing, because an aggregate slot hid its arguments and a CASE base form kept one collation;
# task-2094 fixed both, and task2094.cases grades the rest of that code.
collate-concat-left	SELECT ('a' COLLATE NOCASE || 'x') = 'AX' AS l, 'AX' = ('a' COLLATE NOCASE || 'x') AS r, ('a' || 'x' COLLATE NOCASE) = 'AX' AS inner_right;
collate-concat-left-operand-wins	SELECT ('a' COLLATE NOCASE || 'b' COLLATE BINARY) = 'AB' AS nocase_first, ('a' COLLATE BINARY || 'b' COLLATE NOCASE) = 'AB' AS binary_first;
collate-explicit-left-beats-right	SELECT ('AX' COLLATE BINARY) = ('a' COLLATE NOCASE || 'x') AS binary_left, ('a' COLLATE NOCASE || 'x') = ('AX' COLLATE BINARY) AS nocase_left;
collate-outer-wins	SELECT ('a' COLLATE NOCASE || 'x') COLLATE BINARY = 'AX' AS v;
collate-concat-column	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT id FROM t WHERE (s COLLATE NOCASE || '') = 'a' ORDER BY id;
collate-implicit-not-through-concat	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT id FROM t WHERE n || '' = 'a' ORDER BY id;
collate-concat-column-binary	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT id FROM t WHERE (n COLLATE BINARY || '') = 'a' ORDER BY id;
collate-function-argument	SELECT upper('a' COLLATE NOCASE) = 'a' AS up, substr('xa' COLLATE NOCASE, 2) = 'A' AS sub, coalesce(NULL, 'a' COLLATE NOCASE) = 'A' AS co;
collate-cast-explicit	SELECT CAST('a' COLLATE NOCASE AS TEXT) = 'A' AS v;
collate-cast-column	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT id FROM t WHERE CAST(n AS TEXT) = 'a' ORDER BY id;
collate-unary-plus-column	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT id FROM t WHERE +n = 'a' ORDER BY id;
collate-case-then	SELECT CASE WHEN 1 THEN 'a' COLLATE NOCASE END = 'A' AS v;
collate-scalar-subquery	SELECT (SELECT 'a' COLLATE NOCASE) = 'A' AS v;
collate-in-list	SELECT 'ax' IN ('A' COLLATE NOCASE || 'X') AS rhs, ('a' COLLATE NOCASE || 'x') IN ('AX') AS lhs;
collate-between-bound	SELECT 'AX' BETWEEN ('a' COLLATE NOCASE || 'x') AND 'ZZ' AS v;
collate-order-by	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT s FROM t ORDER BY s COLLATE NOCASE || '', id;
collate-group-by	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT lower(k), c FROM (SELECT s COLLATE NOCASE || '' AS k, count(*) AS c FROM t GROUP BY s COLLATE NOCASE || '') ORDER BY 1;
collate-distinct	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT count(*) FROM (SELECT DISTINCT s COLLATE NOCASE || '' FROM t);
collate-count-distinct	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT count(DISTINCT s COLLATE NOCASE || '') FROM t;
collate-partition-by	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT id, count(*) OVER (PARTITION BY s COLLATE NOCASE || '') FROM t ORDER BY id;
collate-index-seek	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nCREATE INDEX t_sn ON t (s COLLATE NOCASE);\nSELECT id FROM t WHERE s = ('a' COLLATE NOCASE || '') ORDER BY id;
collate-indexed-by	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nCREATE INDEX t_sn ON t (s COLLATE NOCASE);\nSELECT id FROM t INDEXED BY t_sn WHERE s = ('a' COLLATE NOCASE || '') ORDER BY id;
collate-index-between	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nCREATE INDEX t_sn ON t (s COLLATE NOCASE);\nSELECT id FROM t WHERE s BETWEEN 'a' AND ('b' COLLATE NOCASE || '') ORDER BY id;
collate-subquery-column	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT c FROM (SELECT s COLLATE NOCASE || '' AS c, id FROM t) WHERE c = 'a' ORDER BY id;
collate-aggregate-result	CREATE TABLE t (id INTEGER PRIMARY KEY, s TEXT, n TEXT COLLATE NOCASE); INSERT INTO t VALUES (1, 'a', 'a'), (2, 'B', 'B'), (3, 'c', 'c'), (4, 'A', 'A'), (5, 'b', 'b'), (6, 'C', 'C');\nSELECT max(s COLLATE NOCASE) = 'C' FROM t;
collate-case-base-when	SELECT CASE 'a' WHEN 'A' COLLATE NOCASE THEN 1 ELSE 0 END AS v;
collate-ticket-repro-values	SELECT 'B' = 'b' || '' COLLATE NOCASE AS inner, 'B' = ('b' || '') COLLATE NOCASE AS outer;
collate-ticket-repro-table	CREATE TABLE p (id INTEGER PRIMARY KEY, s TEXT); INSERT INTO p VALUES (7, 'a'), (8, 'B');\nSELECT id FROM p WHERE s = 'b' || '' COLLATE NOCASE;
