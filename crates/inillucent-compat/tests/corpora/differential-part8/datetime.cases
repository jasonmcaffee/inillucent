# Differential cases, category `datetime`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential/differential_part8.rs`; nothing else parses this.
dt-001	SELECT date('2020-02-29'), time('2020-02-29 13:45:01'), datetime('2020-02-29 13:45:01')
dt-002	SELECT julianday('2020-01-01'), julianday('1970-01-01'), julianday('2020-01-01 12:00:00')
dt-003	SELECT unixepoch('2020-01-01'), unixepoch('1969-12-31 23:59:59'), unixepoch('2020-01-01T00:00:00Z')
dt-004	SELECT datetime(0,'unixepoch'), datetime(1577836800,'unixepoch'), date(2440587.5)
dt-005	SELECT date('2020-01-31','+1 month'), date('2020-01-31','+1 month','-1 day'), date('2020-03-31','-1 month')
dt-006	SELECT date('2020-01-01','+1 year'), date('2020-02-29','+1 year'), date('2019-02-28','+1 day')
dt-007	SELECT date('2020-01-15','start of month'), date('2020-01-15','start of year'), datetime('2020-01-15 10:11:12','start of day')
dt-008	SELECT date('2020-01-15','weekday 0'), date('2020-01-15','weekday 3'), date('2020-01-15','weekday 6')
dt-009	SELECT strftime('%Y-%m-%d %H:%M:%S','2020-06-05 07:08:09'), strftime('%j','2020-06-05'), strftime('%W','2020-06-05'), strftime('%w','2020-06-05')
dt-010	SELECT strftime('%s','2020-01-01'), strftime('%J','2020-01-01'), strftime('%f','2020-01-01 00:00:01.234')
dt-011	SELECT strftime('%%','2020-01-01'), strftime('%Y%m%d','2020-01-01'), strftime('%d/%m/%Y','2020-01-01')
dt-012	SELECT date('2020-13-01'), date('not a date'), date('2020-02-30'), time('25:00:00')
dt-013	SELECT datetime('2020-01-01','+1 hour','+30 minutes','+15 seconds')
dt-014	SELECT datetime('2020-01-01 00:00:00','+1.5 days'), datetime('2020-01-01','+36 hours')
dt-015	SELECT date('2020-01-01','+1 month','+1 month'), date('2020-01-01','+2 months')
dt-016	SELECT julianday('2020-01-01','+0.5 day'), datetime(2458850.0)
dt-017	SELECT strftime('%Y','1900-01-01'), strftime('%Y','0001-01-01'), date('9999-12-31','+1 day')
dt-018	SELECT datetime('2020-01-01 12:00:00','utc'), datetime('2020-01-01 12:00:00','localtime') IS NOT NULL
dt-019	SELECT timediff('2020-01-02','2020-01-01'), timediff('2020-01-01','2020-01-02')
dt-020	SELECT date('2020-06-05','floor'), date('2020-01-31','+1 month','ceiling'), date('2020-01-31','ceiling','+1 month')
dt-021	SELECT strftime('%Y-%m-%d','2020-01-01 24:00:00'), datetime('2020-01-01 23:59:60')
dt-022	SELECT date(1577836800,'auto'), date('1577836800','auto'), datetime('2020-01-01','subsec')
dt-023	SELECT datetime('2020-01-01T00:00:00.500'), strftime('%f','2020-01-01T00:00:00.500')
dt-024	SELECT julianday('2020-01-01 00:00:00') - julianday('2019-12-31 00:00:00')
dt-025	SELECT date('now') IS NOT NULL, length(date('now'))
