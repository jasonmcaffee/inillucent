# Differential cases, category `upsert`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential_part8.rs`; nothing else parses this.
ups-001	CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER, w TEXT); INSERT INTO t VALUES(1,10,'a'),(2,20,'b'); INSERT INTO t VALUES(1,99,'z') ON CONFLICT(id) DO UPDATE SET v=excluded.v; SELECT * FROM t ORDER BY id
ups-002	CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER, w TEXT); INSERT INTO t VALUES(1,10,'a'),(2,20,'b'); INSERT INTO t VALUES(1,99,'z') ON CONFLICT(id) DO NOTHING; SELECT * FROM t ORDER BY id
ups-003	CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER, w TEXT); INSERT INTO t VALUES(1,10,'a'),(2,20,'b'); INSERT INTO t VALUES(1,99,'z') ON CONFLICT DO UPDATE SET v=v+excluded.v; SELECT * FROM t ORDER BY id
ups-004	CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER, w TEXT); INSERT INTO t VALUES(1,10,'a'),(2,20,'b'); INSERT INTO t VALUES(1,99,'z') ON CONFLICT(id) DO UPDATE SET v=excluded.v WHERE t.v>1000; SELECT * FROM t ORDER BY id
ups-005	CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER, w TEXT); INSERT INTO t VALUES(1,10,'a'),(2,20,'b'); INSERT INTO t VALUES(3,30,'c') ON CONFLICT(id) DO UPDATE SET v=0; SELECT * FROM t ORDER BY id
ups-006	CREATE TABLE t(a UNIQUE, b UNIQUE, c); INSERT INTO t VALUES(1,1,'x'); INSERT INTO t VALUES(1,2,'y') ON CONFLICT(a) DO UPDATE SET c='ua' ON CONFLICT(b) DO UPDATE SET c='ub'; SELECT * FROM t
ups-007	CREATE TABLE t(a UNIQUE, b UNIQUE, c); INSERT INTO t VALUES(1,1,'x'); INSERT INTO t VALUES(2,1,'y') ON CONFLICT(a) DO UPDATE SET c='ua' ON CONFLICT(b) DO UPDATE SET c='ub'; SELECT * FROM t
ups-008	CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER, w TEXT); INSERT INTO t VALUES(1,10,'a'),(2,20,'b'); INSERT INTO t VALUES(1,99,'z') ON CONFLICT(id) DO UPDATE SET v=excluded.v RETURNING id, v
ups-009	CREATE TABLE t(a PRIMARY KEY, b); INSERT INTO t VALUES(1,1); INSERT OR REPLACE INTO t VALUES(1,2); SELECT * FROM t
ups-010	CREATE TABLE t(a PRIMARY KEY, b); INSERT INTO t VALUES(1,1); INSERT OR IGNORE INTO t VALUES(1,2); SELECT * FROM t
ups-011	CREATE TABLE t(a PRIMARY KEY, b NOT NULL); INSERT INTO t VALUES(1,1); INSERT OR REPLACE INTO t VALUES(2,NULL); SELECT count(*) FROM t
ups-012	CREATE TABLE t(id INTEGER PRIMARY KEY, v INTEGER, w TEXT); INSERT INTO t VALUES(1,10,'a'),(2,20,'b'); INSERT INTO t SELECT 1,77,'q' WHERE 1 ON CONFLICT(id) DO UPDATE SET v=excluded.v; SELECT * FROM t ORDER BY id
