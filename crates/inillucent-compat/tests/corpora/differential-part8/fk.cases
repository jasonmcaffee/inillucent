# Differential cases, category `fk`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential_part8.rs`; nothing else parses this.
fk-001	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p(id)); INSERT INTO p VALUES(1); INSERT INTO ch VALUES(1,1); INSERT INTO ch VALUES(2,9)
fk-002	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p(id) ON DELETE CASCADE); INSERT INTO p VALUES(1); INSERT INTO ch VALUES(1,1); DELETE FROM p; SELECT count(*) FROM ch
fk-003	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p(id) ON DELETE SET NULL); INSERT INTO p VALUES(1); INSERT INTO ch VALUES(1,1); DELETE FROM p; SELECT pid FROM ch
fk-004	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p(id) ON DELETE RESTRICT); INSERT INTO p VALUES(1); INSERT INTO ch VALUES(1,1); DELETE FROM p
fk-005	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p(id) ON DELETE SET DEFAULT DEFAULT 7); INSERT INTO p VALUES(1),(7); INSERT INTO ch VALUES(1,1); DELETE FROM p WHERE id=1; SELECT pid FROM ch
fk-006	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p(id) ON UPDATE CASCADE); INSERT INTO p VALUES(1); INSERT INTO ch VALUES(1,1); UPDATE p SET id=5; SELECT pid FROM ch
fk-007	PRAGMA foreign_keys=OFF; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(pid INTEGER REFERENCES p(id)); INSERT INTO ch VALUES(9); SELECT count(*) FROM ch
fk-008	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(id INTEGER PRIMARY KEY, pid INTEGER REFERENCES p(id)); INSERT INTO ch VALUES(1,NULL); SELECT count(*) FROM ch
fk-009	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(pid INTEGER REFERENCES p(id) DEFERRABLE INITIALLY DEFERRED); BEGIN; INSERT INTO ch VALUES(9); INSERT INTO p VALUES(9); COMMIT; SELECT count(*) FROM ch
fk-010	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(pid INTEGER REFERENCES p(id)); INSERT INTO p VALUES(1); INSERT INTO ch VALUES(1); DROP TABLE p
fk-011	PRAGMA foreign_keys=ON; CREATE TABLE p(a,b, PRIMARY KEY(a,b)); CREATE TABLE ch(x,y, FOREIGN KEY(x,y) REFERENCES p(a,b)); INSERT INTO p VALUES(1,2); INSERT INTO ch VALUES(1,2); INSERT INTO ch VALUES(1,3)
fk-012	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(pid REFERENCES p(id)); INSERT INTO p VALUES(1); INSERT INTO ch VALUES('1'); SELECT count(*) FROM ch
fk-013	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(pid INTEGER REFERENCES p(id)); PRAGMA foreign_key_check
fk-014	PRAGMA foreign_keys=ON; CREATE TABLE p(id INTEGER PRIMARY KEY); CREATE TABLE ch(pid INTEGER REFERENCES p(id)); SELECT * FROM pragma_foreign_key_list('ch')
