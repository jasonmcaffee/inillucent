# Differential cases, category `trigger`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential_part8.rs`; nothing else parses this.
trg-001	CREATE TABLE t(a); CREATE TABLE log(m); CREATE TRIGGER tr AFTER INSERT ON t BEGIN INSERT INTO log VALUES('ins '||NEW.a); END; INSERT INTO t VALUES(1),(2); SELECT * FROM log
trg-002	CREATE TABLE t(a); CREATE TABLE log(m); CREATE TRIGGER tr BEFORE DELETE ON t BEGIN INSERT INTO log VALUES('del '||OLD.a); END; INSERT INTO t VALUES(1); DELETE FROM t; SELECT * FROM log
trg-003	CREATE TABLE t(a); CREATE TABLE log(m); CREATE TRIGGER tr AFTER UPDATE OF a ON t BEGIN INSERT INTO log VALUES(OLD.a||'->'||NEW.a); END; INSERT INTO t VALUES(1); UPDATE t SET a=2; SELECT * FROM log
trg-004	CREATE TABLE t(a); CREATE TRIGGER tr BEFORE INSERT ON t WHEN NEW.a<0 BEGIN SELECT RAISE(ABORT,'negative'); END; INSERT INTO t VALUES(1); INSERT INTO t VALUES(-1)
trg-005	CREATE TABLE t(a); CREATE TRIGGER tr BEFORE INSERT ON t WHEN NEW.a<0 BEGIN SELECT RAISE(IGNORE); END; INSERT INTO t VALUES(1),(-1),(2); SELECT * FROM t
trg-006	CREATE TABLE t(a); CREATE VIEW v AS SELECT * FROM t; CREATE TRIGGER tr INSTEAD OF INSERT ON v BEGIN INSERT INTO t VALUES(NEW.a*2); END; INSERT INTO v VALUES(5); SELECT * FROM t
trg-007	CREATE TABLE t(a); CREATE TABLE log(m); CREATE TRIGGER tr AFTER INSERT ON t FOR EACH ROW BEGIN INSERT INTO log VALUES(changes()); END; INSERT INTO t VALUES(1); SELECT * FROM log
trg-008	CREATE TABLE t(a INTEGER PRIMARY KEY, b); CREATE TRIGGER tr AFTER INSERT ON t BEGIN UPDATE t SET b='set' WHERE a=NEW.a; END; INSERT INTO t(b) VALUES('x'); SELECT * FROM t
trg-009	CREATE TABLE t(a); CREATE TABLE log(m); CREATE TRIGGER tr AFTER INSERT ON t BEGIN INSERT INTO log VALUES(last_insert_rowid()); END; INSERT INTO t VALUES(1); SELECT count(*) FROM log
trg-010	CREATE TABLE t(a); CREATE TRIGGER tr AFTER INSERT ON t BEGIN SELECT RAISE(ROLLBACK,'no'); END; INSERT INTO t VALUES(1)
trg-011	CREATE TABLE t(a DEFAULT 3); CREATE TABLE log(m); CREATE TRIGGER tr BEFORE INSERT ON t BEGIN INSERT INTO log VALUES(NEW.a); END; INSERT INTO t DEFAULT VALUES; SELECT * FROM log
trg-012	CREATE TABLE t(a); CREATE TRIGGER tr BEFORE UPDATE ON t BEGIN SELECT RAISE(FAIL,'nope'); END; INSERT INTO t VALUES(1); UPDATE t SET a=2
