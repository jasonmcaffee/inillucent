# Differential cases, category `minmax`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential/differential_part8.rs`; nothing else parses this.
mmx-001	SELECT min(1,1.0), typeof(min(1,1.0)), max(1,1.0), typeof(max(1,1.0))
mmx-002	SELECT min(1.0,1), typeof(min(1.0,1)), max(1.0,1), typeof(max(1.0,1))
mmx-003	SELECT min('a','a'), max(2,2.0), typeof(max(2,2.0))
mmx-004	CREATE TABLE t(a); INSERT INTO t VALUES(1),(1.0); SELECT min(a), typeof(min(a)), max(a), typeof(max(a)) FROM t
mmx-005	CREATE TABLE t(a); INSERT INTO t VALUES(1.0),(1); SELECT min(a), typeof(min(a)), max(a), typeof(max(a)) FROM t
mmx-006	SELECT min(1,2,1.0), max(1,1.0,1)
