# Differential cases, category `todo`: what the todo service example found wrong in 1.0.30.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential/differential_part8.rs`; nothing else parses this.
#
# task-2132. A LEFT JOIN sought by an index on part of its ON; RIGHT and FULL joins through an
# index; the JSON subtype through json_group_array and json_group_object; UPDATE ... FROM a
# table function, a derived table and a join; a table function joined by a WHERE equality on a
# column it does not take as an argument; collation in an aggregate's ORDER BY and in min and max.
left-extra-on-noindex	CREATE TABLE list (id INTEGER PRIMARY KEY, name TEXT);\nCREATE TABLE todo (id INTEGER PRIMARY KEY, list_id INTEGER, parent_id INTEGER, completed INTEGER, position INTEGER);\nINSERT INTO list VALUES (1, 'Home'), (2, 'Work'), (3, 'Empty');\nINSERT INTO todo VALUES (1, 1, NULL, 0, 1), (2, 1, NULL, 1, 2), (3, 2, NULL, 0, 1), (4, 1, 1, 0, 1), (5, 9, NULL, 0, 1);\nSELECT l.id, t.id FROM list l LEFT JOIN todo t ON t.list_id = l.id AND t.parent_id IS NULL ORDER BY l.id, t.id
left-extra-on-isnull	CREATE TABLE list (id INTEGER PRIMARY KEY, name TEXT);\nCREATE TABLE todo (id INTEGER PRIMARY KEY, list_id INTEGER, parent_id INTEGER, completed INTEGER, position INTEGER);\nINSERT INTO list VALUES (1, 'Home'), (2, 'Work'), (3, 'Empty');\nINSERT INTO todo VALUES (1, 1, NULL, 0, 1), (2, 1, NULL, 1, 2), (3, 2, NULL, 0, 1), (4, 1, 1, 0, 1), (5, 9, NULL, 0, 1);\nCREATE INDEX todo_list ON todo (list_id);\nSELECT l.id, t.id FROM list l LEFT JOIN todo t ON t.list_id = l.id AND t.parent_id IS NULL ORDER BY l.id, t.id
