left-extra-on-three-terms	CREATE TABLE list (id INTEGER PRIMARY KEY, name TEXT);\nCREATE TABLE todo (id INTEGER PRIMARY KEY, list_id INTEGER, parent_id INTEGER, completed INTEGER, position INTEGER);\nINSERT INTO list VALUES (1, 'Home'), (2, 'Work'), (3, 'Empty');\nINSERT INTO todo VALUES (1, 1, NULL, 0, 1), (2, 1, NULL, 1, 2), (3, 2, NULL, 0, 1), (4, 1, 1, 0, 1), (5, 9, NULL, 0, 1);\nCREATE INDEX todo_list ON todo (list_id);\nSELECT l.id, t.id, t.position FROM list l LEFT JOIN todo t ON t.list_id = l.id AND t.parent_id IS NULL AND t.position > 1 ORDER BY l.id, t.id
left-extra-on-null-rows	CREATE TABLE list (id INTEGER PRIMARY KEY, name TEXT);\nCREATE TABLE todo (id INTEGER PRIMARY KEY, list_id INTEGER, parent_id INTEGER, completed INTEGER, position INTEGER);\nINSERT INTO list VALUES (1, 'Home'), (2, 'Work'), (3, 'Empty');\nINSERT INTO todo VALUES (1, 1, NULL, 0, 1), (2, 1, NULL, 1, 2), (3, 2, NULL, 0, 1), (4, 1, 1, 0, 1), (5, 9, NULL, 0, 1);\nCREATE INDEX todo_list ON todo (list_id);\nSELECT l.id FROM list l LEFT JOIN todo t ON t.list_id = l.id AND t.parent_id IS NULL WHERE t.id IS NULL ORDER BY l.id
left-extra-on-rowid-seek	CREATE TABLE list (id INTEGER PRIMARY KEY, name TEXT);\nCREATE TABLE todo (id INTEGER PRIMARY KEY, list_id INTEGER, parent_id INTEGER, completed INTEGER, position INTEGER);\nINSERT INTO list VALUES (1, 'Home'), (2, 'Work'), (3, 'Empty');\nINSERT INTO todo VALUES (1, 1, NULL, 0, 1), (2, 1, NULL, 1, 2), (3, 2, NULL, 0, 1), (4, 1, 1, 0, 1), (5, 9, NULL, 0, 1);\nSELECT t.id, l.name FROM todo t LEFT JOIN list l ON l.id = t.list_id AND l.name = 'Home' ORDER BY t.id
left-extra-on-chained	CREATE TABLE list (id INTEGER PRIMARY KEY, name TEXT);\nCREATE TABLE todo (id INTEGER PRIMARY KEY, list_id INTEGER, parent_id INTEGER, completed INTEGER, position INTEGER);\nINSERT INTO list VALUES (1, 'Home'), (2, 'Work'), (3, 'Empty');\nINSERT INTO todo VALUES (1, 1, NULL, 0, 1), (2, 1, NULL, 1, 2), (3, 2, NULL, 0, 1), (4, 1, 1, 0, 1), (5, 9, NULL, 0, 1);\nCREATE INDEX todo_list ON todo (list_id);\nSELECT l.id, t.id, c.id FROM list l LEFT JOIN todo t ON t.list_id = l.id AND t.parent_id IS NULL LEFT JOIN todo c ON c.parent_id = t.id AND c.completed = 0 ORDER BY l.id, t.id, c.id
right-join-index	CREATE TABLE list (id INTEGER PRIMARY KEY, name TEXT);\nCREATE TABLE todo (id INTEGER PRIMARY KEY, list_id INTEGER, parent_id INTEGER, completed INTEGER, position INTEGER);\nINSERT INTO list VALUES (1, 'Home'), (2, 'Work'), (3, 'Empty');\nINSERT INTO todo VALUES (1, 1, NULL, 0, 1), (2, 1, NULL, 1, 2), (3, 2, NULL, 0, 1), (4, 1, 1, 0, 1), (5, 9, NULL, 0, 1);\nCREATE INDEX todo_list ON todo (list_id);\nSELECT l.id, t.id FROM list l RIGHT JOIN todo t ON t.list_id = l.id ORDER BY t.id
full-join-index-extra-on	CREATE TABLE list (id INTEGER PRIMARY KEY, name TEXT);\nCREATE TABLE todo (id INTEGER PRIMARY KEY, list_id INTEGER, parent_id INTEGER, completed INTEGER, position INTEGER);\nINSERT INTO list VALUES (1, 'Home'), (2, 'Work'), (3, 'Empty');\nINSERT INTO todo VALUES (1, 1, NULL, 0, 1), (2, 1, NULL, 1, 2), (3, 2, NULL, 0, 1), (4, 1, 1, 0, 1), (5, 9, NULL, 0, 1);\nCREATE INDEX todo_list ON todo (list_id);\nSELECT l.id, t.id FROM list l FULL JOIN todo t ON t.list_id = l.id AND t.parent_id IS NULL ORDER BY l.id, t.id
json-group-array-object	CREATE TABLE todo (id INTEGER PRIMARY KEY);\nINSERT INTO todo VALUES (1), (2);\nSELECT json_group_array(json_object('id', id)) FROM todo
json-group-object-object	CREATE TABLE todo (id INTEGER PRIMARY KEY);\nINSERT INTO todo VALUES (1), (2);\nSELECT json_group_object('k' || id, json_object('id', id)) FROM todo
json-group-array-array	CREATE TABLE todo (id INTEGER PRIMARY KEY);\nINSERT INTO todo VALUES (1), (2);\nSELECT json_group_array(json_array(id, 'a')) FROM todo
json-group-array-extract	CREATE TABLE d (b TEXT);\nINSERT INTO d VALUES ('{"a":[1,2]}'), ('{"a":"x"}');\nSELECT json_group_array(json_extract(b, '$.a')) FROM d
json-group-array-ordered	CREATE TABLE todo (id INTEGER PRIMARY KEY);\nINSERT INTO todo VALUES (1), (2);\nSELECT json_group_array(json_object('id', id) ORDER BY id DESC) FROM todo
json-group-array-plain-text	CREATE TABLE d (b TEXT);\nINSERT INTO d VALUES ('{"a":1}');\nSELECT json_group_array(b) FROM d
update-from-json-each	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 0), (2, 0), (3, 0);\nUPDATE todo SET position = j.key + 1 FROM json_each('[3,1,2]') AS j WHERE todo.id = j.value;\nSELECT changes();\nSELECT * FROM todo ORDER BY id
update-from-derived-json-each	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 0), (2, 0), (3, 0);\nUPDATE todo SET position = p.pos FROM (SELECT value AS id, key + 10 AS pos FROM json_each('[3,1,2]')) AS p WHERE todo.id = p.id;\nSELECT changes();\nSELECT * FROM todo ORDER BY id
update-from-derived-count	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 0), (2, 0), (3, 0);\nCREATE TABLE ord (id INTEGER, pos INTEGER);\nINSERT INTO ord VALUES (3, 20), (1, 21), (2, 22);\nUPDATE todo SET position = p.pos FROM (SELECT id, pos FROM ord) AS p WHERE todo.id = p.id;\nSELECT changes(), total_changes();\nSELECT * FROM todo ORDER BY id
update-from-series	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 0), (2, 0), (3, 0);\nUPDATE todo SET position = g.value FROM generate_series(1, 3) AS g WHERE g.value = todo.id + 1;\nSELECT changes();\nSELECT * FROM todo ORDER BY id
update-from-join	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 0), (2, 0), (3, 0);\nCREATE TABLE a (x, y);\nINSERT INTO a VALUES (1, 10), (2, 20);\nCREATE TABLE b (x, z);\nINSERT INTO b VALUES (1, 100), (2, 200), (3, 300);\nUPDATE todo SET position = a.y + b.z FROM a JOIN b ON b.x = a.x WHERE todo.id = a.x;\nSELECT changes();\nSELECT * FROM todo ORDER BY id
update-from-join-using	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 0), (2, 0), (3, 0);\nCREATE TABLE a (x, y);\nINSERT INTO a VALUES (1, 10), (2, 20);\nCREATE TABLE b (x, z);\nINSERT INTO b VALUES (1, 100), (2, 200), (3, 300);\nUPDATE todo SET position = b.z FROM a JOIN b USING (x) WHERE todo.id = x + 1;\nSELECT changes();\nSELECT * FROM todo ORDER BY id
update-from-left-join	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 0), (2, 0), (3, 0);\nCREATE TABLE a (x, y);\nINSERT INTO a VALUES (1, 10), (2, 20);\nCREATE TABLE b (x, z);\nINSERT INTO b VALUES (1, 100), (2, 200), (3, 300);\nUPDATE todo SET position = coalesce(b.z, -1) FROM a LEFT JOIN b ON b.x = a.x + 5 WHERE todo.id = a.x;\nSELECT changes();\nSELECT * FROM todo ORDER BY id
where-equality-json-each	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 0), (2, 0), (3, 0);\nSELECT todo.id, j.key FROM todo, json_each('[3,1,2]') AS j WHERE todo.id = j.value ORDER BY todo.id
where-equality-series	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 0), (2, 0), (3, 0);\nSELECT t.id, g.value FROM todo t, generate_series(1, 3) AS g WHERE t.id = g.value ORDER BY t.id
where-equality-json-each-first	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 0), (2, 0), (3, 0);\nSELECT todo.id, j.key FROM json_each('[3,1,2]') AS j, todo WHERE j.value = todo.id AND todo.position = 0 ORDER BY todo.id
agg-order-column-collation	CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE);\nINSERT INTO tag (name) VALUES ('outdoor'), ('Repairs'), ('apple'), ('Zebra'), (NULL);\nSELECT json_group_array(name ORDER BY name) FROM tag
agg-order-group-concat	CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE);\nINSERT INTO tag (name) VALUES ('outdoor'), ('Repairs'), ('apple'), ('Zebra'), (NULL);\nSELECT group_concat(name, ',' ORDER BY name) FROM tag
agg-order-explicit-nocase	CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE);\nINSERT INTO tag (name) VALUES ('outdoor'), ('Repairs'), ('apple'), ('Zebra'), (NULL);\nSELECT group_concat(name, ',' ORDER BY name COLLATE NOCASE) FROM tag
agg-order-explicit-binary	CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE);\nINSERT INTO tag (name) VALUES ('outdoor'), ('Repairs'), ('apple'), ('Zebra'), (NULL);\nSELECT group_concat(name, ',' ORDER BY name COLLATE BINARY DESC) FROM tag
agg-order-nulls-last	CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE);\nINSERT INTO tag (name) VALUES ('outdoor'), ('Repairs'), ('apple'), ('Zebra'), (NULL);\nSELECT json_group_array(name ORDER BY name NULLS LAST) FROM tag
minmax-column-collation	CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE);\nINSERT INTO tag (name) VALUES ('outdoor'), ('Repairs'), ('apple'), ('Zebra'), (NULL);\nSELECT max(name), min(name) FROM tag
minmax-explicit-binary	CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE);\nINSERT INTO tag (name) VALUES ('outdoor'), ('Repairs'), ('apple'), ('Zebra'), (NULL);\nSELECT max(name COLLATE BINARY), min(name COLLATE BINARY) FROM tag
minmax-grouped	CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE);\nINSERT INTO tag (name) VALUES ('outdoor'), ('Repairs'), ('apple'), ('Zebra'), (NULL);\nSELECT id % 2, max(name), min(name) FROM tag GROUP BY id % 2 ORDER BY 1
minmax-bare-column	CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE);\nINSERT INTO tag (name) VALUES ('outdoor'), ('Repairs'), ('apple'), ('Zebra'), (NULL);\nSELECT id, max(name) FROM tag
minmax-window	CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE);\nINSERT INTO tag (name) VALUES ('outdoor'), ('Repairs'), ('apple'), ('Zebra'), (NULL);\nSELECT max(name) OVER (), min(name) OVER () FROM tag LIMIT 1
minmax-indexed	CREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT COLLATE NOCASE);\nINSERT INTO tag (name) VALUES ('outdoor'), ('Repairs'), ('apple'), ('Zebra'), (NULL);\nCREATE INDEX tag_name ON tag (name);\nSELECT max(name), min(name) FROM tag
fts-trigger-insert	CREATE TABLE todo (id INTEGER PRIMARY KEY, title TEXT NOT NULL, notes TEXT NOT NULL DEFAULT '');\nCREATE VIRTUAL TABLE f USING fts5(title, notes);\nCREATE TRIGGER t3 AFTER INSERT ON todo BEGIN INSERT INTO f (rowid, title, notes) VALUES (NEW.id, NEW.title, NEW.notes); END;\nCREATE TRIGGER t4 AFTER DELETE ON todo BEGIN DELETE FROM f WHERE rowid = OLD.id; END;\nCREATE TRIGGER t5 AFTER UPDATE ON todo BEGIN UPDATE f SET title = NEW.title, notes = NEW.notes WHERE rowid = NEW.id; END;\nINSERT INTO todo (title) VALUES ('x');\nINSERT INTO todo (title, notes) VALUES ('y', 'hello world');\nSELECT rowid, * FROM f ORDER BY rowid
fts-trigger-update-delete	CREATE TABLE todo (id INTEGER PRIMARY KEY, title TEXT NOT NULL, notes TEXT NOT NULL DEFAULT '');\nCREATE VIRTUAL TABLE f USING fts5(title, notes);\nCREATE TRIGGER t3 AFTER INSERT ON todo BEGIN INSERT INTO f (rowid, title, notes) VALUES (NEW.id, NEW.title, NEW.notes); END;\nCREATE TRIGGER t4 AFTER DELETE ON todo BEGIN DELETE FROM f WHERE rowid = OLD.id; END;\nCREATE TRIGGER t5 AFTER UPDATE ON todo BEGIN UPDATE f SET title = NEW.title, notes = NEW.notes WHERE rowid = NEW.id; END;\nINSERT INTO todo (title) VALUES ('x'), ('y');\nUPDATE todo SET title = 'z' WHERE id = 1;\nDELETE FROM todo WHERE id = 2;\nSELECT rowid, * FROM f ORDER BY rowid;\nSELECT rowid FROM f WHERE f MATCH 'z'
fts-trigger-failed-statement	CREATE TABLE todo (id INTEGER PRIMARY KEY, title TEXT NOT NULL, notes TEXT NOT NULL DEFAULT '');\nCREATE VIRTUAL TABLE f USING fts5(title, notes);\nCREATE TRIGGER t3 AFTER INSERT ON todo BEGIN INSERT INTO f (rowid, title, notes) VALUES (NEW.id, NEW.title, NEW.notes); END;\nCREATE TRIGGER t4 AFTER DELETE ON todo BEGIN DELETE FROM f WHERE rowid = OLD.id; END;\nCREATE TRIGGER t5 AFTER UPDATE ON todo BEGIN UPDATE f SET title = NEW.title, notes = NEW.notes WHERE rowid = NEW.id; END;\nINSERT INTO todo (title) VALUES ('alpha'), ('beta');\nINSERT INTO todo (title) VALUES ('gamma'), (NULL);\nSELECT rowid, title FROM f ORDER BY rowid
fts-trigger-rollback	CREATE TABLE todo (id INTEGER PRIMARY KEY, title TEXT NOT NULL, notes TEXT NOT NULL DEFAULT '');\nCREATE VIRTUAL TABLE f USING fts5(title, notes);\nCREATE TRIGGER t3 AFTER INSERT ON todo BEGIN INSERT INTO f (rowid, title, notes) VALUES (NEW.id, NEW.title, NEW.notes); END;\nCREATE TRIGGER t4 AFTER DELETE ON todo BEGIN DELETE FROM f WHERE rowid = OLD.id; END;\nCREATE TRIGGER t5 AFTER UPDATE ON todo BEGIN UPDATE f SET title = NEW.title, notes = NEW.notes WHERE rowid = NEW.id; END;\nINSERT INTO todo (title) VALUES ('alpha');\nBEGIN;\nINSERT INTO todo (title) VALUES ('delta');\nSELECT rowid, title FROM f ORDER BY rowid;\nROLLBACK;\nSELECT rowid, title FROM f ORDER BY rowid
fts-trigger-insert-select	CREATE TABLE todo (id INTEGER PRIMARY KEY, title TEXT NOT NULL, notes TEXT NOT NULL DEFAULT '');\nCREATE VIRTUAL TABLE f USING fts5(title, notes);\nCREATE TRIGGER t3 AFTER INSERT ON todo BEGIN INSERT INTO f (rowid, title, notes) VALUES (NEW.id, NEW.title, NEW.notes); END;\nCREATE TRIGGER t4 AFTER DELETE ON todo BEGIN DELETE FROM f WHERE rowid = OLD.id; END;\nCREATE TRIGGER t5 AFTER UPDATE ON todo BEGIN UPDATE f SET title = NEW.title, notes = NEW.notes WHERE rowid = NEW.id; END;\nINSERT INTO todo (title) VALUES ('alpha'), ('beta');\nINSERT INTO todo (title) SELECT 'copy ' || title FROM todo;\nSELECT rowid, title FROM f ORDER BY rowid;\nSELECT rowid FROM f WHERE f MATCH 'copy' ORDER BY rowid
temp-trigger-fires	CREATE TABLE todo (id INTEGER PRIMARY KEY, title TEXT);\nCREATE TABLE log (id INTEGER PRIMARY KEY, what TEXT);\nCREATE TEMP TRIGGER t8 AFTER INSERT ON todo BEGIN INSERT INTO log (what) VALUES (NEW.title); END;\nINSERT INTO todo (title) VALUES ('second');\nSELECT * FROM log
total-changes	CREATE TABLE t (a);\nINSERT INTO t VALUES (1), (2);\nSELECT total_changes();\nUPDATE t SET a = a + 1;\nSELECT total_changes();\nUPDATE t SET a = a + 1;\nSELECT total_changes(), changes()
window-in-derived-table	CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER);\nINSERT INTO t VALUES (1, 5), (2, 7), (3, 5);\nSELECT * FROM (SELECT id, rank() OVER (ORDER BY n DESC) AS r FROM t) WHERE id = 3
window-in-cte	CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER);\nINSERT INTO t VALUES (1, 5), (2, 7), (3, 5);\nWITH ranked AS (SELECT id, rank() OVER (ORDER BY n DESC) AS r FROM t) SELECT * FROM ranked WHERE id = 3
window-in-view	CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER);\nINSERT INTO t VALUES (1, 5), (2, 7), (3, 5);\nCREATE VIEW v AS SELECT id, rank() OVER (ORDER BY n DESC) AS r FROM t;\nSELECT * FROM v WHERE id = 3
window-top-per-group	CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER);\nINSERT INTO t VALUES (1, 5), (2, 7), (3, 5);\nSELECT * FROM (SELECT id, n, row_number() OVER (PARTITION BY n ORDER BY id) AS rn FROM t) WHERE rn <= 1 ORDER BY id
window-derived-joined	CREATE TABLE t (id INTEGER PRIMARY KEY, n INTEGER);\nINSERT INTO t VALUES (1, 5), (2, 7), (3, 5);\nSELECT t.id, r.r FROM t JOIN (SELECT id, dense_rank() OVER (ORDER BY n) AS r FROM t) AS r ON r.id = t.id ORDER BY t.id
update-set-correlated-json-each	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 1), (2, 2);\nUPDATE todo SET position = (SELECT key + 1 FROM json_each('[2,1]') WHERE value = todo.id) WHERE id IN (SELECT value FROM json_each('[2,1]'));\nSELECT * FROM todo ORDER BY id
update-set-json-each-count	CREATE TABLE todo (id INTEGER PRIMARY KEY, position INTEGER);\nINSERT INTO todo VALUES (1, 1), (2, 2);\nUPDATE todo SET position = (SELECT count(*) FROM json_each('[1,2,3]'));\nSELECT * FROM todo ORDER BY id
correlated-derived-table	CREATE TABLE todo (id INTEGER PRIMARY KEY);\nCREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT);\nCREATE TABLE todo_tag (todo_id INTEGER, tag_id INTEGER);\nINSERT INTO todo VALUES (1), (2), (3);\nINSERT INTO tag VALUES (1, 'b'), (2, 'a'), (3, 'c');\nINSERT INTO todo_tag VALUES (1, 1), (1, 2), (2, 3);\nSELECT t.id, (SELECT json_group_array(name) FROM (SELECT g.name FROM todo_tag tt JOIN tag g ON g.id = tt.tag_id WHERE tt.todo_id = t.id ORDER BY g.name)) FROM todo t ORDER BY t.id
correlated-derived-count	CREATE TABLE todo (id INTEGER PRIMARY KEY);\nCREATE TABLE tag (id INTEGER PRIMARY KEY, name TEXT);\nCREATE TABLE todo_tag (todo_id INTEGER, tag_id INTEGER);\nINSERT INTO todo VALUES (1), (2), (3);\nINSERT INTO tag VALUES (1, 'b'), (2, 'a'), (3, 'c');\nINSERT INTO todo_tag VALUES (1, 1), (1, 2), (2, 3);\nSELECT t.id, (SELECT count(*) FROM (SELECT tag_id FROM todo_tag WHERE todo_id = t.id)) FROM todo t ORDER BY t.id
temp-schema-names	CREATE TEMP TABLE scratch (x);\nSELECT name FROM sqlite_temp_schema;\nSELECT name FROM temp.sqlite_master;\nSELECT name FROM temp.sqlite_schema;\nSELECT name FROM sqlite_temp_master;\nSELECT count(*) FROM sqlite_schema WHERE name = 'scratch'
