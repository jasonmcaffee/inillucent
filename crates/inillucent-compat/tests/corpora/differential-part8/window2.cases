# Differential cases, category `window2`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential_part8.rs`; nothing else parses this.
wex-001	CREATE TABLE t(g TEXT, v INTEGER); INSERT INTO t VALUES('a',1),('a',2),('a',2),('b',5),('b',NULL),('c',7); SELECT g,v,sum(v) OVER (PARTITION BY g ORDER BY v RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE CURRENT ROW) FROM t ORDER BY g,v
wex-002	CREATE TABLE t(g TEXT, v INTEGER); INSERT INTO t VALUES('a',1),('a',2),('a',2),('b',5),('b',NULL),('c',7); SELECT g,v,sum(v) OVER (PARTITION BY g ORDER BY v RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE TIES) FROM t ORDER BY g,v
wex-003	CREATE TABLE t(g TEXT, v INTEGER); INSERT INTO t VALUES('a',1),('a',2),('a',2),('b',5),('b',NULL),('c',7); SELECT g,v,sum(v) OVER (PARTITION BY g ORDER BY v RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE GROUP) FROM t ORDER BY g,v
wex-004	CREATE TABLE t(g TEXT, v INTEGER); INSERT INTO t VALUES('a',1),('a',2),('a',2),('b',5),('b',NULL),('c',7); SELECT g,v,sum(v) OVER (PARTITION BY g ORDER BY v RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE NO OTHERS) FROM t ORDER BY g,v
wex-005	CREATE TABLE t(g TEXT, v INTEGER); INSERT INTO t VALUES('a',1),('a',2),('a',2),('b',5),('b',NULL),('c',7); SELECT g,v,count(*) OVER (ORDER BY v ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING EXCLUDE CURRENT ROW) FROM t ORDER BY g,v
wex-006	CREATE TABLE t(g TEXT, v INTEGER); INSERT INTO t VALUES('a',1),('a',2),('a',2),('b',5),('b',NULL),('c',7); SELECT g,v,count(*) OVER (ORDER BY v GROUPS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW EXCLUDE TIES) FROM t ORDER BY g,v
wex-007	CREATE TABLE t(g TEXT, v INTEGER); INSERT INTO t VALUES('a',1),('a',2),('a',2),('b',5),('b',NULL),('c',7); SELECT g,v,sum(v) OVER (ORDER BY v ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING EXCLUDE CURRENT ROW) FROM t ORDER BY g,v
wex-008	CREATE TABLE t(g TEXT, v INTEGER); INSERT INTO t VALUES('a',1),('a',2),('a',2),('b',5),('b',NULL),('c',7); SELECT g,v,sum(v) OVER (PARTITION BY g ORDER BY v EXCLUDE NO OTHERS) FROM t ORDER BY g,v
