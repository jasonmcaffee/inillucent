# Differential cases, category `task2083`: a seek whose key is converted the way SQLite converts it.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential_part8.rs`; nothing else parses this.
#
# task-2083 found that an index join into an untyped column returned no rows, and a sweep over
# every pair of declared types found three more defects of the same kind. The join probe was
# a CAST rather than the comparison's affinity. The planner used an index whose affinity the
# comparison disagreed with. A probe was converted where SQLite compares two non-numeric
# columns unconverted. And a NULL seek key found the index's NULL entries. The release build
# before task-2083 disagreed with SQLite 3.53.4 on 37 of these 43 cases. The rest of this
# corpus never joined through an index on an untyped column, and never gave a join or a
# correlated subquery a key such as 3.5, 'abc' or NULL. `ix` is the inner table and index
# type, `ox` the outer column type.

ix-ticket	CREATE TABLE h1(id INTEGER PRIMARY KEY, a); INSERT INTO h1 VALUES (1,3); CREATE INDEX h1_a ON h1(a);\nCREATE TABLE h2(id INTEGER PRIMARY KEY, a INTEGER); INSERT INTO h2 VALUES (1,3); CREATE INDEX h2_a ON h2(a);\nCREATE TABLE s1(k); INSERT INTO s1 VALUES (3);\nCREATE TABLE s2(k INTEGER); INSERT INTO s2 VALUES (3);\nSELECT count(*) FROM s1, h1 WHERE h1.a = s1.k;\nSELECT count(*) FROM s2, h1 WHERE h1.a = s2.k;\nSELECT count(*) FROM s1, h2 WHERE h2.a = s1.k;\nSELECT count(*) FROM h1 WHERE a = 3;\nSELECT count(*) FROM h1 WHERE a = (SELECT k FROM s1);\nUPDATE h1 SET a = 4 FROM s1 WHERE h1.a = s1.k;\nSELECT id, a FROM h1;
ix-literal-untyped	CREATE TABLE h(id INTEGER PRIMARY KEY, a , b); INSERT INTO h VALUES (1, 3, 0), (2, '3', 0), (3, 3.0, 0), (4, '3.0', 0), (5, 3.5, 0), (6, 'abc', 0), (7, x'33', 0), (8, NULL, 0), (9, ' 3', 0), (10, '3e0', 0), (11, 0, 0), (12, '0', 0); CREATE INDEX h_a ON h(a);\nSELECT 'eq 3', id FROM h WHERE a = 3 ORDER BY id;\nSELECT 'gt 3', id FROM h WHERE a > 3 ORDER BY id;\nSELECT 'eq ''3''', id FROM h WHERE a = '3' ORDER BY id;\nSELECT 'gt ''3''', id FROM h WHERE a > '3' ORDER BY id;\nSELECT 'eq 3.0', id FROM h WHERE a = 3.0 ORDER BY id;\nSELECT 'gt 3.0', id FROM h WHERE a > 3.0 ORDER BY id;\nSELECT 'eq ''3.0''', id FROM h WHERE a = '3.0' ORDER BY id;\nSELECT 'gt ''3.0''', id FROM h WHERE a > '3.0' ORDER BY id;\nSELECT 'eq 3.5', id FROM h WHERE a = 3.5 ORDER BY id;\nSELECT 'gt 3.5', id FROM h WHERE a > 3.5 ORDER BY id;\nSELECT 'eq ''abc''', id FROM h WHERE a = 'abc' ORDER BY id;\nSELECT 'gt ''abc''', id FROM h WHERE a > 'abc' ORDER BY id;\nSELECT 'eq x''33''', id FROM h WHERE a = x'33' ORDER BY id;\nSELECT 'gt x''33''', id FROM h WHERE a > x'33' ORDER BY id;\nSELECT 'eq NULL', id FROM h WHERE a = NULL ORDER BY id;\nSELECT 'gt NULL', id FROM h WHERE a > NULL ORDER BY id;\nSELECT 'eq '' 3''', id FROM h WHERE a = ' 3' ORDER BY id;\nSELECT 'gt '' 3''', id FROM h WHERE a > ' 3' ORDER BY id;\nSELECT 'eq ''3e0''', id FROM h WHERE a = '3e0' ORDER BY id;\nSELECT 'gt ''3e0''', id FROM h WHERE a > '3e0' ORDER BY id;\nSELECT 'eq 0', id FROM h WHERE a = 0 ORDER BY id;\nSELECT 'gt 0', id FROM h WHERE a > 0 ORDER BY id;\nSELECT 'eq ''0''', id FROM h WHERE a = '0' ORDER BY id;\nSELECT 'gt ''0''', id FROM h WHERE a > '0' ORDER BY id;\nSELECT 'in', id FROM h WHERE a IN (3, '3', 3.5, 'abc', NULL) ORDER BY id;
ix-untyped-ox-untyped	CREATE TABLE h(id INTEGER PRIMARY KEY, a , b); INSERT INTO h VALUES (1, 3, 0), (2, '3', 0), (3, 3.0, 0), (4, '3.0', 0), (5, 3.5, 0), (6, 'abc', 0), (7, x'33', 0), (8, NULL, 0), (9, ' 3', 0), (10, '3e0', 0), (11, 0, 0), (12, '0', 0); CREATE INDEX h_a ON h(a);\nCREATE TABLE s(n INTEGER, k ); INSERT INTO s VALUES (1, 3), (2, '3'), (3, 3.0), (4, '3.0'), (5, 3.5), (6, 'abc'), (7, x'33'), (8, NULL), (9, ' 3'), (10, '3e0'), (11, 0), (12, '0');\nSELECT 'join', s.n, h.id FROM s, h WHERE h.a = s.k ORDER BY 2, 3;\nSELECT 'mirror', s.n, h.id FROM s, h WHERE s.k = h.a ORDER BY 2, 3;\nSELECT 'rowid', s.n, h.id FROM s, h WHERE h.id = s.k ORDER BY 2, 3;\nSELECT 'correlated', n, (SELECT count(*) FROM h WHERE h.a = s.k), (SELECT sum(id) FROM h WHERE h.a = s.k) FROM s ORDER BY n;\nUPDATE h SET b = b + 1 FROM s WHERE h.a = s.k;\nSELECT 'update', id, b FROM h ORDER BY id;
