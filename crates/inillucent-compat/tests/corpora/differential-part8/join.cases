# Differential cases, category `join`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential/differential_part8.rs`; nothing else parses this.
join-001	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l JOIN r ON l.id=r.id ORDER BY l.id, r.w
join-002	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l LEFT JOIN r ON l.id=r.id ORDER BY l.id, r.w
join-003	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l RIGHT JOIN r ON l.id=r.id ORDER BY r.id, r.w
join-004	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l FULL OUTER JOIN r ON l.id=r.id ORDER BY l.id, r.id, r.w
join-005	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l CROSS JOIN r ORDER BY l.id, r.id, r.w
join-006	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l JOIN r USING(id) ORDER BY id, w
join-007	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l LEFT JOIN r USING(id) ORDER BY id, w
join-008	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l NATURAL JOIN r ORDER BY l.id
join-009	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l LEFT JOIN r ON l.id=r.id AND r.w='y' ORDER BY l.id
join-010	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l LEFT JOIN r ON l.id=r.id WHERE r.w='y' ORDER BY l.id
join-011	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT count(*) FROM l a1 JOIN l a2 ON a1.id < a2.id
join-012	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l JOIN r ON l.id+1 = r.id ORDER BY l.id
join-013	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT l.id, count(r.id) FROM l LEFT JOIN r ON l.id=r.id GROUP BY l.id ORDER BY l.id
join-014	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l, r WHERE l.id=r.id ORDER BY l.id, r.w
join-015	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l LEFT JOIN r ON 0 ORDER BY l.id
join-016	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM (SELECT 1 AS id) x LEFT JOIN (SELECT 1 AS id, 2 AS y) z USING(id)
join-017	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT l.id, r.id FROM l LEFT JOIN r ON l.id=r.id ORDER BY l.id, r.id
join-018	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT count(*) FROM l JOIN r JOIN l AS l2
join-019	CREATE TABLE p(a); CREATE TABLE q(a); INSERT INTO p VALUES(NULL),(1); INSERT INTO q VALUES(NULL),(1); SELECT count(*) FROM p JOIN q ON p.a=q.a
join-020	CREATE TABLE l(id INTEGER, v TEXT); CREATE TABLE r(id INTEGER, w TEXT); INSERT INTO l VALUES(1,'a'),(2,'b'),(3,'c'); INSERT INTO r VALUES(1,'x'),(1,'y'),(4,'z'); SELECT * FROM l LEFT JOIN r ON l.id=r.id LEFT JOIN l AS l3 ON l3.id=r.id ORDER BY l.id, r.w
