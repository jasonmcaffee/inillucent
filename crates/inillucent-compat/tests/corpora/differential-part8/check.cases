# Differential cases, category `check`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential_part8.rs`; nothing else parses this.
chk-001	CREATE TABLE t(a CHECK(a>0)); INSERT INTO t VALUES(1); INSERT INTO t VALUES(-1)
chk-002	CREATE TABLE t(a CHECK(a>0)); INSERT INTO t VALUES(NULL); SELECT count(*) FROM t
chk-003	CREATE TABLE t(a,b, CHECK(a<b)); INSERT INTO t VALUES(1,2); INSERT INTO t VALUES(2,1)
chk-004	CREATE TABLE t(a TEXT CHECK(length(a)<3)); INSERT INTO t VALUES('ab'); INSERT INTO t VALUES('abcd')
chk-005	CREATE TABLE t(a CHECK(a IN (1,2))); INSERT INTO t VALUES(2); INSERT INTO t VALUES(3)
chk-006	CREATE TABLE t(a CHECK(a>0)); INSERT INTO t VALUES(1); UPDATE t SET a=-1
chk-007	CREATE TABLE t(a INTEGER CHECK(a>0)); INSERT INTO t VALUES('5'); SELECT a, typeof(a) FROM t
