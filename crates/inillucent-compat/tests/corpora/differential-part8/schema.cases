# Differential cases, category `schema`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential/differential_part8.rs`; nothing else parses this.
sch-001	CREATE TABLE t(a INTEGER PRIMARY KEY, b TEXT); SELECT type,name,tbl_name,sql FROM sqlite_schema ORDER BY name
sch-002	CREATE TABLE t(a); CREATE INDEX i ON t(a); SELECT type,name,tbl_name FROM sqlite_schema ORDER BY name
sch-003	CREATE TABLE t(a); CREATE VIEW v AS SELECT * FROM t; SELECT type,name FROM sqlite_master ORDER BY name
sch-004	CREATE TABLE "t t"("a b"); SELECT sql FROM sqlite_schema
sch-005	CREATE TABLE t(a UNIQUE); SELECT type,name,tbl_name FROM sqlite_schema ORDER BY name
