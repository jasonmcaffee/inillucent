# Differential cases, category `task2134`: defects found while building the coffee shop example.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential/differential_part8.rs`; nothing else parses this.
#
# jd: julianday() on a whole millisecond. SQLite keeps a Julian day as an integer count of
# milliseconds and divides by 86400000 when asked; adding the clock as fractions of a day in
# doubles landed on a neighbouring double, and a difference of two days was off by 5e-10.
t2134-jd-001	SELECT julianday('2026-09-25T17:30:00Z'), julianday('2026-09-25T17:30:00Z') - julianday('2026-09-25T08:00:00Z')
t2134-jd-002	SELECT julianday('2026-09-25 17:30:00.123'), julianday('2026-09-25 17:30:00+05:30'), julianday('2026-09-25 17:30:00-01:15')
t2134-jd-003	SELECT julianday('2026-09-25','+7 hours','+3 minutes','+1.5 seconds'), julianday('2026-09-25','-7 hours'), julianday('2026-09-25T17:30:00Z','+0.1 day')
t2134-jd-004	SELECT julianday(2461309.12345678912), strftime('%J','2026-09-25T17:30:00'), (julianday('2026-09-25 17:31:07') - julianday('2026-09-25 08:00:00')) * 24
#
# vgi: an index on a VIRTUAL generated column. The column is in no record, so the index is kept
# as an index on the column's expression: the build, every write and the integrity check compute
# the key, and a query on the column seeks it, because the binder turns the column into its
# expression.
t2134-vgi-001	CREATE TABLE payment (id INTEGER PRIMARY KEY, at TEXT NOT NULL, business_day TEXT GENERATED ALWAYS AS (date(at)) VIRTUAL, amount INTEGER) STRICT;\nINSERT INTO payment (at, amount) VALUES ('2026-09-20 10:00:00', 5), ('2026-09-21 09:00:00', 7);\nCREATE INDEX payment_day ON payment (business_day);\nINSERT INTO payment (at, amount) VALUES ('2026-09-20 18:00:00', 11), ('2026-09-22 08:00:00', 13);\nUPDATE payment SET at = '2026-09-22 12:00:00' WHERE id = 2;\nDELETE FROM payment WHERE id = 1;\nSELECT id, business_day, amount FROM payment WHERE business_day = '2026-09-22' ORDER BY id;\nSELECT business_day, sum(amount) FROM payment GROUP BY business_day ORDER BY business_day;\nPRAGMA integrity_check
t2134-vgi-002	CREATE TABLE payment (id INTEGER PRIMARY KEY, at TEXT NOT NULL, business_day TEXT GENERATED ALWAYS AS (date(at)) VIRTUAL);\nINSERT INTO payment (at) VALUES ('2026-09-20 10:00:00'), ('2026-09-20 11:00:00');\nCREATE INDEX payment_day ON payment (business_day);\nEXPLAIN QUERY PLAN SELECT id FROM payment WHERE business_day = '2026-09-20';\nPRAGMA index_info(payment_day)
t2134-vgi-003	CREATE TABLE g (a INTEGER, b INTEGER GENERATED ALWAYS AS (a * 2) VIRTUAL);\nINSERT INTO g (a) VALUES (1), (2), (3);\nCREATE UNIQUE INDEX gb ON g (b);\nINSERT INTO g (a) VALUES (4);\nSELECT a FROM g WHERE b = 4;\nSELECT a, b FROM g WHERE b > 2 ORDER BY b;\nREINDEX gb;\nPRAGMA integrity_check
t2134-vgi-004	CREATE TABLE g (a INTEGER, b INTEGER GENERATED ALWAYS AS (a * 2) VIRTUAL);\nINSERT INTO g (a) VALUES (1), (1);\nCREATE UNIQUE INDEX gb ON g (b);\nSELECT count(*) FROM g
#
# jga: a JSON group aggregate's result read by a JSON function is nested, not quoted. The mark
# travels from one JSON call to the next, and an aggregate result or a scalar subquery is not a
# JSON call, so the binder wraps either in json() or jsonb(). A derived table and a CTE lose the
# mark in SQLite too, and the last case checks that they still quote.
t2134-jga-001	CREATE TABLE sale (day TEXT, item TEXT, cents INTEGER);\nINSERT INTO sale VALUES ('2026-09-20', 'Latte', 1050), ('2026-09-20', 'Croissant', 375), ('2026-09-21', 'Latte', 525);\nSELECT json_object('day', day, 'items', json_group_array(item)) FROM sale GROUP BY day ORDER BY day;\nSELECT json_array(json_group_array(item)) FROM sale;\nSELECT json_object('by', json_group_object(item, cents)) FROM sale WHERE day = '2026-09-20';\nSELECT json_object('b', jsonb_group_array(item)) FROM sale WHERE day = '2026-09-21'
t2134-jga-002	CREATE TABLE sale (day TEXT, item TEXT, cents INTEGER);\nINSERT INTO sale VALUES ('2026-09-20', 'Latte', 1050), ('2026-09-20', 'Croissant', 375), ('2026-09-21', 'Latte', 525);\nSELECT json_array(json_group_array(item) FILTER (WHERE cents > 500)) FROM sale;\nSELECT json_array(json_group_array(item), 'x') FROM sale GROUP BY day HAVING json_array_length(json_group_array(item)) > 1;\nSELECT json_group_array(item) -> 0, json_quote(json_group_array(item)) FROM sale
t2134-jga-003	CREATE TABLE sale (day TEXT, item TEXT);\nINSERT INTO sale VALUES ('2026-09-20', 'Latte'), ('2026-09-21', 'Mocha');\nSELECT json_object('items', (SELECT json_group_array(item) FROM sale));\nSELECT json_array((SELECT json_object('a', 1)), (SELECT '{"a":1}')));\nSELECT json_object('n', t.items) FROM (SELECT json_group_array(item) AS items FROM sale) AS t;\nWITH c AS (SELECT json_group_array(item) AS items FROM sale) SELECT json_array(items) FROM c
#
# oba: a bare ORDER BY identifier that matches a written alias is that result column, before a
# column of the FROM tables. It was resolved as the table column, so a grouped query sorted by
# whichever row stood for each group. An expression, a qualified name and an implicit name still
# read the table, as in SQLite.
t2134-oba-001	CREATE TABLE order_line (id INTEGER PRIMARY KEY, order_id INTEGER, item TEXT, quantity INTEGER);\nINSERT INTO order_line (order_id, item, quantity) VALUES (1, 'Latte', 1), (1, 'Tea', 1), (2, 'Latte', 1), (3, 'Latte', 1), (3, 'Latte', 1), (4, 'Tea', 3), (5, 'Mocha', 2), (5, 'Mocha', 1), (5, 'Latte', 1);\nSELECT item, sum(quantity) AS quantity FROM order_line GROUP BY item ORDER BY quantity DESC;\nSELECT order_id, count(*) AS id FROM order_line GROUP BY order_id ORDER BY id DESC, order_id;\nSELECT item, max(quantity) AS quantity FROM order_line GROUP BY item ORDER BY quantity, item;\nSELECT item, sum(quantity) AS quantity FROM order_line GROUP BY item HAVING quantity > 1 ORDER BY item
t2134-oba-002	CREATE TABLE t (id INTEGER PRIMARY KEY, q INTEGER, a INTEGER);\nINSERT INTO t VALUES (1, 30, 5), (2, 10, 6), (3, 20, 4);\nSELECT id AS q, q AS id FROM t ORDER BY q;\nSELECT id AS q FROM t ORDER BY q DESC;\nSELECT q AS a FROM t ORDER BY a;\nSELECT q AS a FROM t ORDER BY t.a;\nSELECT id AS a FROM t ORDER BY "a";\nSELECT id AS "Q" FROM t ORDER BY q DESC;\nSELECT id q FROM t ORDER BY q DESC;\nSELECT id AS q, q AS id FROM t ORDER BY q + 0;\nSELECT *, id AS q FROM t ORDER BY q DESC
t2134-oba-003	CREATE TABLE t (id INTEGER PRIMARY KEY, a INTEGER);\nCREATE TABLE y (id INTEGER, a INTEGER);\nSELECT t.a, y.a FROM t, y ORDER BY a
