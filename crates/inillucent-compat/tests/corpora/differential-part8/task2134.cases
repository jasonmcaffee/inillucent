# Differential cases, category `task2134`: defects found while building the coffee shop example.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential/differential_part8.rs`; nothing else parses this.
#
# jd: julianday() on a whole millisecond. SQLite keeps a Julian day as an integer count of
# milliseconds and divides by 86400000 when asked; adding the clock as fractions of a day in
# doubles landed on a neighbouring double, and a difference of two days was off by 5e-10.
t2134-jd-001	SELECT julianday('2026-09-25T17:30:00Z'), julianday('2026-09-25T17:30:00Z') - julianday('2026-09-25T08:00:00Z')
t2134-jd-002	SELECT julianday('2026-09-25 17:30:00.123'), julianday('2026-09-25 17:30:00+05:30'), julianday('2026-09-25 17:30:00-01:15')
t2134-jd-003	SELECT julianday('2026-09-25','+7 hours','+3 minutes','+1.5 seconds'), julianday('2026-09-25','-7 hours'), julianday('2026-09-25T17:30:00Z','+0.1 day')
t2134-jd-004	SELECT julianday(2461309.12345678912), strftime('%J','2026-09-25T17:30:00'), (julianday('2026-09-25 17:31:07') - julianday('2026-09-25 08:00:00')) * 24
#
# vgi: an index on a VIRTUAL generated column. The column is in no record, so the index is kept
# as an index on the column's expression: the build, every write and the integrity check compute
# the key, and a query on the column seeks it, because the binder turns the column into its
# expression.
t2134-vgi-001	CREATE TABLE payment (id INTEGER PRIMARY KEY, at TEXT NOT NULL, business_day TEXT GENERATED ALWAYS AS (date(at)) VIRTUAL, amount INTEGER) STRICT;\nINSERT INTO payment (at, amount) VALUES ('2026-09-20 10:00:00', 5), ('2026-09-21 09:00:00', 7);\nCREATE INDEX payment_day ON payment (business_day);\nINSERT INTO payment (at, amount) VALUES ('2026-09-20 18:00:00', 11), ('2026-09-22 08:00:00', 13);\nUPDATE payment SET at = '2026-09-22 12:00:00' WHERE id = 2;\nDELETE FROM payment WHERE id = 1;\nSELECT id, business_day, amount FROM payment WHERE business_day = '2026-09-22' ORDER BY id;\nSELECT business_day, sum(amount) FROM payment GROUP BY business_day ORDER BY business_day;\nPRAGMA integrity_check
t2134-vgi-002	CREATE TABLE payment (id INTEGER PRIMARY KEY, at TEXT NOT NULL, business_day TEXT GENERATED ALWAYS AS (date(at)) VIRTUAL);\nINSERT INTO payment (at) VALUES ('2026-09-20 10:00:00'), ('2026-09-20 11:00:00');\nCREATE INDEX payment_day ON payment (business_day);\nEXPLAIN QUERY PLAN SELECT id FROM payment WHERE business_day = '2026-09-20';\nPRAGMA index_info(payment_day)
t2134-vgi-003	CREATE TABLE g (a INTEGER, b INTEGER GENERATED ALWAYS AS (a * 2) VIRTUAL);\nINSERT INTO g (a) VALUES (1), (2), (3);\nCREATE UNIQUE INDEX gb ON g (b);\nINSERT INTO g (a) VALUES (4);\nSELECT a FROM g WHERE b = 4;\nSELECT a, b FROM g WHERE b > 2 ORDER BY b;\nREINDEX gb;\nPRAGMA integrity_check
t2134-vgi-004	CREATE TABLE g (a INTEGER, b INTEGER GENERATED ALWAYS AS (a * 2) VIRTUAL);\nINSERT INTO g (a) VALUES (1), (1);\nCREATE UNIQUE INDEX gb ON g (b);\nSELECT count(*) FROM g
#
# jga: a JSON group aggregate's result read by a JSON function is nested, not quoted. The mark
# travels from one JSON call to the next, and an aggregate result or a scalar subquery is not a
# JSON call, so the binder wraps either in json() or jsonb(). A derived table and a CTE lose the
# mark in SQLite too, and the last case checks that they still quote.
t2134-jga-001	CREATE TABLE sale (day TEXT, item TEXT, cents INTEGER);\nINSERT INTO sale VALUES ('2026-09-20', 'Latte', 1050), ('2026-09-20', 'Croissant', 375), ('2026-09-21', 'Latte', 525);\nSELECT json_object('day', day, 'items', json_group_array(item)) FROM sale GROUP BY day ORDER BY day;\nSELECT json_array(json_group_array(item)) FROM sale;\nSELECT json_object('by', json_group_object(item, cents)) FROM sale WHERE day = '2026-09-20';\nSELECT json_object('b', jsonb_group_array(item)) FROM sale WHERE day = '2026-09-21'
t2134-jga-002	CREATE TABLE sale (day TEXT, item TEXT, cents INTEGER);\nINSERT INTO sale VALUES ('2026-09-20', 'Latte', 1050), ('2026-09-20', 'Croissant', 375), ('2026-09-21', 'Latte', 525);\nSELECT json_array(json_group_array(item) FILTER (WHERE cents > 500)) FROM sale;\nSELECT json_array(json_group_array(item), 'x') FROM sale GROUP BY day HAVING json_array_length(json_group_array(item)) > 1;\nSELECT json_group_array(item) -> 0, json_quote(json_group_array(item)) FROM sale
t2134-jga-003	CREATE TABLE sale (day TEXT, item TEXT);\nINSERT INTO sale VALUES ('2026-09-20', 'Latte'), ('2026-09-21', 'Mocha');\nSELECT json_object('items', (SELECT json_group_array(item) FROM sale));\nSELECT json_array((SELECT json_object('a', 1)), (SELECT '{"a":1}')));\nSELECT json_object('n', t.items) FROM (SELECT json_group_array(item) AS items FROM sale) AS t;\nWITH c AS (SELECT json_group_array(item) AS items FROM sale) SELECT json_array(items) FROM c
#
# oba: a bare ORDER BY identifier that matches a written alias is that result column, before a
# column of the FROM tables. It was resolved as the table column, so a grouped query sorted by
# whichever row stood for each group. An expression, a qualified name and an implicit name still
# read the table, as in SQLite.
t2134-oba-001	CREATE TABLE order_line (id INTEGER PRIMARY KEY, order_id INTEGER, item TEXT, quantity INTEGER);\nINSERT INTO order_line (order_id, item, quantity) VALUES (1, 'Latte', 1), (1, 'Tea', 1), (2, 'Latte', 1), (3, 'Latte', 1), (3, 'Latte', 1), (4, 'Tea', 3), (5, 'Mocha', 2), (5, 'Mocha', 1), (5, 'Latte', 1);\nSELECT item, sum(quantity) AS quantity FROM order_line GROUP BY item ORDER BY quantity DESC;\nSELECT order_id, count(*) AS id FROM order_line GROUP BY order_id ORDER BY id DESC, order_id;\nSELECT item, max(quantity) AS quantity FROM order_line GROUP BY item ORDER BY quantity, item;\nSELECT item, sum(quantity) AS quantity FROM order_line GROUP BY item HAVING quantity > 1 ORDER BY item
t2134-oba-002	CREATE TABLE t (id INTEGER PRIMARY KEY, q INTEGER, a INTEGER);\nINSERT INTO t VALUES (1, 30, 5), (2, 10, 6), (3, 20, 4);\nSELECT id AS q, q AS id FROM t ORDER BY q;\nSELECT id AS q FROM t ORDER BY q DESC;\nSELECT q AS a FROM t ORDER BY a;\nSELECT q AS a FROM t ORDER BY t.a;\nSELECT id AS a FROM t ORDER BY "a";\nSELECT id AS "Q" FROM t ORDER BY q DESC;\nSELECT id q FROM t ORDER BY q DESC;\nSELECT id AS q, q AS id FROM t ORDER BY q + 0;\nSELECT *, id AS q FROM t ORDER BY q DESC
t2134-oba-003	CREATE TABLE t (id INTEGER PRIMARY KEY, a INTEGER);\nCREATE TABLE y (id INTEGER, a INTEGER);\nSELECT t.a, y.a FROM t, y ORDER BY a
#
# tvf: a table valued function over another one's column, and a join on an expression of one.
# The first failed because the outer function took the inner one's argument as its own unusable
# constraint and rechecked it where the inner column did not exist. The second failed because
# sources_used had no arm for a JSON call, so the planner put the table first and sought it with
# a key that read a term not read yet.
t2134-tvf-001	SELECT s.key, r.value FROM json_each('{"a":[1,2],"b":[3]}') s, json_each(s.value) r;\nSELECT t.value, r.value FROM json_each('[[1,2],[3]]') t, json_each(t.value) r;\nSELECT s.key, r.value FROM json_each('{"a":[1,2],"b":[3]}') s, json_tree(s.value) r WHERE r.type = 'integer';\nSELECT a.key, b.key, c.value FROM json_each('{"x":{"y":[1,2]},"z":{"w":[3]}}') a, json_each(a.value) b, json_each(b.value) c;\nSELECT s.value, g.value FROM json_each('[2,3]') s, generate_series(1, s.value) g
t2134-tvf-002	CREATE TABLE ingredient (id INTEGER PRIMARY KEY, on_hand INTEGER);\nINSERT INTO ingredient VALUES (1, 100), (2, 500), (3, 7);\nSELECT i.id, c.value ->> '$.counted' FROM json_each('[{"ingredient_id":1,"counted":90},{"ingredient_id":2,"counted":500}]') c JOIN ingredient i ON i.id = c.value ->> '$.ingredient_id';\nSELECT i.id FROM ingredient i, json_each('[{"ingredient_id":1},{"ingredient_id":3}]') c WHERE i.id = c.value ->> '$.ingredient_id';\nSELECT i.id FROM json_each('[{"ingredient_id":1},{"ingredient_id":3}]') c, ingredient i WHERE i.id = json_extract(c.value, '$.ingredient_id')
t2134-tvf-003	CREATE VIRTUAL TABLE f USING fts5(body);\nINSERT INTO f VALUES ('red apple'), ('green pear'), ('red cherry');\nCREATE TABLE q (word TEXT);\nINSERT INTO q VALUES ('red'), ('pear');\nSELECT q.word, f.body FROM q, f WHERE f MATCH q.word ORDER BY 1, 2;\nSELECT q.word, count(*) FROM q JOIN f ON f MATCH q.word GROUP BY q.word ORDER BY 1;\nSELECT j.value, f.body FROM json_each('["red","pear"]') j, f WHERE f MATCH j.value ORDER BY 1, 2
#
# win: a correlated scalar subquery beside a window function, and a windowed query ordered by an
# expression. Both were refused with status unsupported. The subquery is now computed by the
# query below the window pass, and a computed sort key is appended to the row before the sort.
t2134-win-001	CREATE TABLE order_line (id INTEGER PRIMARY KEY, order_id INTEGER, item TEXT, quantity INTEGER);\nINSERT INTO order_line (order_id, item, quantity) VALUES (1, 'Latte', 1), (1, 'Tea', 1), (2, 'Latte', 1);\nCREATE TABLE orders (id INTEGER PRIMARY KEY, paid_at TEXT);\nINSERT INTO orders VALUES (1, '08:00'), (2, '08:05'), (3, '07:55');\nSELECT o.id, (SELECT count(*) FROM order_line l WHERE l.order_id = o.id) AS n, row_number() OVER (ORDER BY o.paid_at) AS place FROM orders o;\nSELECT o.id, (SELECT group_concat(item) FROM order_line l WHERE l.order_id = o.id) AS items, rank() OVER (ORDER BY (SELECT count(*) FROM order_line l WHERE l.order_id = o.id) DESC) AS r FROM orders o ORDER BY o.id;\nSELECT o.id, EXISTS (SELECT 1 FROM order_line l WHERE l.order_id = o.id) AS e, count(*) OVER () FROM orders o ORDER BY o.id
t2134-win-002	CREATE TABLE ingredient (id INTEGER PRIMARY KEY, name TEXT, on_hand INTEGER, reorder_level INTEGER);\nINSERT INTO ingredient VALUES (1, 'beans', 100, 300), (2, 'milk', 500, 100), (3, 'cups', 7, 50);\nSELECT id, on_hand <= reorder_level AS low, rank() OVER (ORDER BY on_hand DESC) AS r FROM ingredient ORDER BY low DESC, name;\nSELECT id, rank() OVER (ORDER BY on_hand DESC) AS r FROM ingredient ORDER BY lower(name);\nSELECT id, on_hand <= reorder_level AS low, rank() OVER (ORDER BY on_hand DESC) AS r FROM ingredient ORDER BY 2, 1;\nSELECT id, rank() OVER (ORDER BY on_hand DESC) AS r FROM ingredient ORDER BY on_hand + 0, r * -1 LIMIT 2;\nSELECT DISTINCT on_hand > 50 AS big, count(*) OVER (PARTITION BY on_hand > 50) AS c FROM ingredient ORDER BY big
#
# pd: a WHERE condition on a view's or derived table's columns is copied into it, so the inner
# query filters before it builds its rows. The first case fails without the copy: the view's
# column raises an error on every row the WHERE excludes, SQLite never computes those rows, and a
# view built in full does. The rest check that the copy is not made where it would change rows:
# the right side of a LEFT JOIN, DISTINCT, LIMIT, GROUP BY, a compound and random().
t2134-pd-001	CREATE TABLE t (id INTEGER PRIMARY KEY, a INTEGER);\nINSERT INTO t VALUES (1, 1), (2, 2), (5, 5);\nCREATE VIEW risky AS SELECT id, CASE WHEN id = 5 THEN a ELSE abs(-9223372036854775807 - 1) END AS x FROM t;\nSELECT * FROM risky WHERE id = 5;\nSELECT * FROM (SELECT id, CASE WHEN id = 5 THEN a ELSE abs(-9223372036854775807 - 1) END AS x FROM t) WHERE id > 4
t2134-pd-002	CREATE TABLE customer (id INTEGER PRIMARY KEY, name TEXT);\nCREATE TABLE orders (id INTEGER PRIMARY KEY, customer_id INTEGER, status TEXT);\nCREATE TABLE order_line (id INTEGER PRIMARY KEY, order_id INTEGER, quantity INTEGER);\nWITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 40) INSERT INTO customer SELECT i, 'c' || i FROM n;\nWITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 200) INSERT INTO orders SELECT i, CASE WHEN i % 7 = 0 THEN NULL ELSE i % 40 + 1 END, CASE i % 3 WHEN 0 THEN 'open' WHEN 1 THEN 'paid' ELSE 'void' END FROM n;\nWITH RECURSIVE n(i) AS (SELECT 1 UNION ALL SELECT i + 1 FROM n WHERE i < 600) INSERT INTO order_line SELECT i, i % 200 + 1, i % 4 + 1 FROM n;\nCREATE VIEW order_summary AS SELECT o.id, o.status, c.name AS customer_name, (SELECT sum(quantity) FROM order_line l WHERE l.order_id = o.id) AS items FROM orders o LEFT JOIN customer c ON c.id = o.customer_id;\nCREATE VIEW v_plain AS SELECT o.id, o.status, c.name AS customer_name FROM orders o LEFT JOIN customer c ON c.id = o.customer_id;\nSELECT * FROM order_summary WHERE id = 57;\nSELECT * FROM v_plain WHERE id = 57;\nSELECT count(*), sum(items) FROM order_summary WHERE status = 'paid' AND customer_name IS NULL;\nSELECT * FROM order_summary WHERE items > 10 ORDER BY id LIMIT 3;\nSELECT v.id, v.customer_name FROM v_plain v JOIN customer c ON c.name = v.customer_name WHERE v.id BETWEEN 10 AND 14 ORDER BY v.id;\nSELECT c.id, v.id FROM customer c LEFT JOIN v_plain v ON v.customer_name = c.name AND v.id < 5 WHERE c.id < 4 ORDER BY 1, 2;\nSELECT c.id, v.id FROM customer c LEFT JOIN v_plain v ON v.customer_name = c.name WHERE v.id IS NULL AND c.id < 3 ORDER BY 1
t2134-pd-003	CREATE TABLE orders (id INTEGER PRIMARY KEY, status TEXT);\nINSERT INTO orders VALUES (1, 'open'), (2, 'paid'), (3, 'paid'), (4, 'PAID'), (5, 'void');\nCREATE TABLE customer (id INTEGER PRIMARY KEY);\nINSERT INTO customer VALUES (1), (2);\nSELECT count(*) FROM (SELECT DISTINCT status FROM orders) WHERE status = 'paid';\nSELECT count(*) FROM (SELECT DISTINCT status COLLATE NOCASE AS status FROM orders) WHERE status = 'paid' COLLATE BINARY;\nSELECT count(*) FROM (SELECT id FROM orders ORDER BY id LIMIT 3) WHERE id > 1;\nSELECT * FROM (SELECT status, count(*) AS n FROM orders GROUP BY status) WHERE n > 1 ORDER BY status;\nSELECT count(*) FROM (SELECT id FROM orders UNION ALL SELECT id FROM customer) WHERE id < 3;\nSELECT count(*) FROM (SELECT id, random() AS r FROM orders) WHERE id = 3
