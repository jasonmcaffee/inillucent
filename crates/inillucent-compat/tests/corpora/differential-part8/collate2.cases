# Differential cases, category `collate2`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential_part8.rs`; nothing else parses this.
clp-001	SELECT ('a'='A') COLLATE NOCASE, ('a'='A' COLLATE NOCASE), 'a'='A' COLLATE NOCASE
clp-002	SELECT (1=1) COLLATE NOCASE, (0) COLLATE NOCASE, ('b'>'A') COLLATE NOCASE
clp-003	SELECT ('B'<'a') COLLATE NOCASE, 'B'<'a' COLLATE NOCASE, 'B' COLLATE NOCASE < 'a'
clp-004	SELECT (('a'='A') COLLATE NOCASE) COLLATE BINARY
clp-005	SELECT ('a' LIKE 'A') COLLATE NOCASE, ('a' IN ('A')) COLLATE NOCASE
clp-006	SELECT (CASE WHEN 'a'='A' THEN 1 ELSE 0 END) COLLATE NOCASE
clp-007	SELECT ('a' IS 'A') COLLATE NOCASE, ('a' IS NOT 'A') COLLATE NOCASE
clp-008	SELECT (SELECT 'a'='A') COLLATE NOCASE
clp-009	CREATE TABLE t(a,b); INSERT INTO t VALUES('a','A'); SELECT (a=b) COLLATE NOCASE, a=b FROM t
clp-010	SELECT ('a'||'')=('A'||'') COLLATE NOCASE, (('a'||'')=('A'||'')) COLLATE NOCASE
