# Differential cases, category `subquery`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential/differential_part8.rs`; nothing else parses this.
sub-001	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT id,(SELECT sum(w) FROM b WHERE b.id=a.id) FROM a ORDER BY id
sub-002	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT id FROM a WHERE EXISTS(SELECT 1 FROM b WHERE b.id=a.id) ORDER BY id
sub-003	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT id FROM a WHERE NOT EXISTS(SELECT 1 FROM b WHERE b.id=a.id) ORDER BY id
sub-004	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT (SELECT w FROM b ORDER BY w) AS x, typeof((SELECT w FROM b))
sub-005	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT id FROM a WHERE v IN (SELECT w FROM b) ORDER BY id
sub-006	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT id FROM a WHERE v NOT IN (SELECT w FROM b) ORDER BY id
sub-007	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT id FROM a WHERE v > (SELECT min(w) FROM b) ORDER BY id
sub-008	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT id, (SELECT count(*) FROM b WHERE b.w > a.v) FROM a ORDER BY id
sub-009	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT * FROM (SELECT id, max(v) mv FROM a GROUP BY id) WHERE mv > 10 ORDER BY id
sub-010	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT id FROM a WHERE (id,v) IN (SELECT id,w FROM b)
sub-011	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT EXISTS(SELECT 1 WHERE 0), EXISTS(SELECT NULL)
sub-012	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT id FROM a WHERE v = (SELECT w FROM b WHERE b.id = 99)
sub-013	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT a.id, (SELECT group_concat(w) FROM b WHERE b.id=a.id) FROM a ORDER BY a.id
sub-014	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT id FROM a WHERE v > ALL (SELECT w FROM b WHERE b.id=1)
sub-015	CREATE TABLE a(id INTEGER, v INTEGER); CREATE TABLE b(id INTEGER, w INTEGER); INSERT INTO a VALUES(1,10),(2,20),(3,NULL); INSERT INTO b VALUES(1,100),(1,200),(2,NULL); SELECT count(*) FROM a WHERE id IN (SELECT id FROM b GROUP BY id HAVING count(*)>1)
