# Differential cases, category `rowid2`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential/differential_part8.rs`; nothing else parses this.
rwe-001	CREATE TABLE t(a INTEGER PRIMARY KEY, b); INSERT INTO t VALUES(9223372036854775807,'x'); INSERT INTO t(b) VALUES('y'); SELECT count(*) FROM t
rwe-002	CREATE TABLE t(a INTEGER PRIMARY KEY AUTOINCREMENT, b); INSERT INTO t VALUES(9223372036854775807,'x'); INSERT INTO t(b) VALUES('y')
rwe-003	CREATE TABLE t(a); INSERT INTO t VALUES(1); UPDATE t SET rowid=100; SELECT rowid,a FROM t
rwe-004	CREATE TABLE t(a); INSERT INTO t(rowid,a) VALUES(50,'x'); SELECT rowid,a FROM t
rwe-005	CREATE TABLE t(a); INSERT INTO t(oid,a) VALUES(50,'x'); SELECT rowid,a FROM t
rwe-006	CREATE TABLE t(a); INSERT INTO t VALUES(1); SELECT rowid+0, rowid*2 FROM t
rwe-007	CREATE TABLE t(a); INSERT INTO t VALUES(1),(2); DELETE FROM t WHERE rowid IN (SELECT rowid FROM t LIMIT 1); SELECT count(*) FROM t
rwe-008	CREATE TABLE t(a INTEGER PRIMARY KEY, b); INSERT INTO t VALUES(-9223372036854775808,'x'); INSERT INTO t(b) VALUES('y'); SELECT a FROM t ORDER BY a
