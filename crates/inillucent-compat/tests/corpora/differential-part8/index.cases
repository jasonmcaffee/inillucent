# Differential cases, category `index`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential_part8.rs`; nothing else parses this.
idx-001	CREATE TABLE t(a,b); CREATE INDEX i ON t(a); INSERT INTO t VALUES(1,2); SELECT * FROM t INDEXED BY i WHERE a=1
idx-002	CREATE TABLE t(a,b); CREATE INDEX i ON t(a); INSERT INTO t VALUES(1,2); SELECT * FROM t NOT INDEXED WHERE a=1
idx-003	CREATE TABLE t(a,b); CREATE INDEX i ON t(a); SELECT * FROM t INDEXED BY nosuch WHERE a=1
idx-004	CREATE TABLE t(a,b); CREATE INDEX i ON t(a) WHERE b>0; INSERT INTO t VALUES(1,2),(3,-1); SELECT a FROM t WHERE b>0 AND a=1
idx-005	CREATE TABLE t(a); CREATE INDEX i ON t(abs(a)); INSERT INTO t VALUES(-3); SELECT a FROM t WHERE abs(a)=3
idx-006	CREATE TABLE t(a,b); CREATE UNIQUE INDEX i ON t(a,b); INSERT INTO t VALUES(1,2); INSERT INTO t VALUES(1,2)
idx-007	CREATE TABLE t(a); CREATE INDEX i ON t(a DESC); INSERT INTO t VALUES(1),(3),(2); SELECT a FROM t ORDER BY a DESC
