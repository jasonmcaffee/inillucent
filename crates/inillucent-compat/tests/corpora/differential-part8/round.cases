# Differential cases, category `round`, from task-1979's review of commit 3073058.
# One case per line: the case's id, a tab, and the statements, with `\n` for a newline.
# Read by `crates/inillucent-compat/tests/differential_part8.rs`; nothing else parses this.
rnd-001	SELECT round(2.675,2), round(1.115,2), round(0.615,2), round(8.835,2)
rnd-002	SELECT round(2.5,0), round(3.5,0), round(-2.5,0), round(0.5,0)
rnd-003	SELECT round(1.0e15+0.5), round(123456789.987654321,5)
rnd-004	SELECT round(2.345,2), round(-2.345,2), round(2.344999999,2)
rnd-005	SELECT round(1,2), typeof(round(1,2)), round('2.675',2)
rnd-006	SELECT round(2.675,-1), round(1234.5,-2)
rnd-007	SELECT printf('%.2f',2.675), printf('%.2f',1.115), printf('%.17g',0.1)
